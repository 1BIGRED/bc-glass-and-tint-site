---
# City page, v2 (website overhaul, 2026-10-29). Layout: _includes/layouts/v2.njk. Styles:
# assets/v2/v2.css plus assets/v2/pages.css. All wording is in _data/pages/henderson.json.
# Out-of-town rule: leads with residential film and windshield chip repair. Reviews are Google
# only, verbatim. JSON-LD: henderson.11tydata.js (FAQPage built from the same faq.items shown).
layout: layouts/v2.njk
extra_css: ["/assets/v2/pages.css"]
permalink: henderson.html
slug: henderson
page_key: henderson
og_image: images/residential-before-after-patio.jpg
og_image_width: 1600
og_image_height: 1200
---
{%- set pg = pages.henderson -%}
{%- set sh = pages.shared -%}
{%- set tel = site.phone.tel -%}
{%- set callText = sh.v2.call + " " + site.phone.display_call -%}

<section class="pg-head" aria-labelledby="pg-h1">
  <div class="v2-wrap pg-head__in">
    <div class="pg-head__copy">
      <nav class="pg-crumb" aria-label="Breadcrumb"><a href="/">{{ sh.crumb.home | safe }}</a><span aria-hidden="true">/</span><a href="/#areas">{{ pg.hero.crumb_parent | safe }}</a><span aria-hidden="true">/</span><span>{{ pg.hero.crumb | safe }}</span></nav>
      <p class="v2-eyebrow">{{ pg.hero.eyebrow | safe }}</p>
      <h1 class="pg-h1" id="pg-h1">{{ pg.hero.heading | safe }}</h1>
      <p class="pg-lede">{{ pg.hero.intro | fill | safe }}</p>
      <div class="pg-actions">
        <a class="v2-btn v2-btn--gold v2-btn--xl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
        <a class="v2-textlink" href="#quote">{{ sh.buttons.free_quote | safe }}</a>
      </div>
    </div>
    <figure class="pg-photo">
      <picture><source srcset="/images/residential-before-after-patio.webp" type="image/webp"><img src="/images/residential-before-after-patio.jpg" width="1600" height="1200" alt="{{ pg.content.image_alt | safe }}" fetchpriority="high"></picture>
    </figure>
  </div>
</section>

<div class="pg-strip">
  <div class="v2-wrap">
    <ul>{% for b in pg.band %}<li>{{ b | safe }}</li>{% endfor %}</ul>
  </div>
</div>

<section class="v2-section" aria-labelledby="content-h">
  <div class="v2-wrap pg-cols">
    <h2 class="v2-h2" id="content-h">{{ pg.content.heading | safe }}</h2>
    <ul class="pg-list">
{%- for li in pg.content.bullets %}
      <li>{{ li | fill | safe }}</li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="facts-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="facts-h">{{ pg.facts.heading | safe }}</h2>
      <p class="v2-body">{{ pg.facts.sub | safe }}</p>
    </div>
    <dl class="pg-facts pg-facts--plain">
{%- for f in pg.facts.items %}
      <div class="pg-facts__row"><dt class="pg-facts__t">{{ f.term | safe }}</dt><dd class="pg-facts__d">{{ f.detail | safe }}<span class="pg-facts__src">{{ f.source | safe }}</span></dd></div>
{%- endfor %}
    </dl>
  </div>
</section>

<section class="v2-section" aria-labelledby="areas-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <h2 class="v2-h2" id="areas-h">{{ pg.areas.heading | safe }}</h2>
    <div class="pg-twocol">
{%- for g in pg.areas.groups %}
      <div class="pg-prose"><h3 class="pg-h3">{{ g.heading | safe }}</h3><p>{{ g.text | safe }}</p></div>
{%- endfor %}
    </div>
    <p class="v2-body">{{ pg.areas.closing | safe }}</p>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="here-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="here-h">{{ pg.getting_here.heading | safe }}</h2>
      <p class="v2-body">{{ pg.getting_here.sub | safe }}</p>
    </div>
    <ul class="pg-info">
{%- for c in pg.getting_here.cards %}
{%- if c.fact == "address" %}{% set ct = site.address.street %}{% set cs = site.address.city + ", " + site.address.region + " " + site.address.postal_code %}{% elif c.fact == "hours" %}{% set ct = site.hours.display %}{% set cs = c.text %}{% else %}{% set ct = c.title %}{% set cs = c.text %}{% endif %}
      <li><b>{{ ct | safe }}</b><span>{{ cs | safe }}</span></li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="v2-section" id="faq" aria-labelledby="faq-h">
  <div class="v2-wrap v2-faq">
    <h2 class="v2-h2" id="faq-h">{{ pg.faq.heading | safe }}</h2>
    <div class="v2-faq__list">
{%- for item in pg.faq.items %}
      <details class="v2-faq__item">
        <summary><h3 class="v2-faq__q">{{ item.question | safe }}</h3><span class="v2-faq__plus" aria-hidden="true"></span></summary>
        <div class="v2-faq__a"><p>{{ item.answer | safe }}</p></div>
      </details>
{%- endfor %}
    </div>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="reviews-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <h2 class="v2-h2" id="reviews-h">{{ pg.reviews.heading | safe }}</h2>
    <div class="pg-quotes">
{%- for r in pg.reviews.items %}
      <blockquote class="pg-quote"><p>"{{ r.quote | safe }}"</p><footer>{{ r.name | safe }}, {{ pg.reviews.label | safe }}</footer></blockquote>
{%- endfor %}
    </div>
    <p class="v2-small">{{ pg.reviews.summary | fill | safe }}</p>
  </div>
</section>

<section class="v2-section" aria-labelledby="more-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="more-h">{{ pg.more.heading | safe }}</h2>
      <p class="v2-body">{{ pg.more.sub | safe }}</p>
    </div>
    <ul class="v2-svcchips">
{%- for l in pg.more.links %}
      <li><a href="{{ l.href | safe }}">{{ l.label | safe }}</a></li>
{%- endfor %}
    </ul>
  </div>
</section>

{%- set week = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] %}
{%- set closedDays = [] %}
{%- for d in week %}{% if not (d in site.hours.days) %}{% set _n = closedDays.push(d) %}{% endif %}{% endfor %}
<section class="v2-band v2-section v2-contactwrap" aria-labelledby="contact-h">
  <div class="v2-wrap v2-contact">
    <div class="v2-contact__talk">
      <h2 class="v2-h2 v2-h2--xl" id="contact-h">{{ pg.contact.heading | safe }}</h2>
      <a class="v2-btn v2-btn--gold v2-btn--xxl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
      <span class="v2-status v2-status--lg" data-bc-status><span class="v2-dot" aria-hidden="true"></span><span class="v2-status__txt"></span></span>
      <p class="v2-body">{{ site.address.display | safe }}<br>{{ site.hours.display | safe }}.{% if closedDays.length %} {{ pg.contact.closed_prefix | safe }} {{ closedDays | join(" and ") }}.{% endif %}</p>
    </div>
    <div class="v2-contact__form">
{% include "quote.njk" %}
    </div>
  </div>
</section>
