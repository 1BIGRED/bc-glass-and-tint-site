---
# Slim informational/service page. All wording is in _data/pages/boat_rv_tint.json; markup
# lives here. JSON-LD: boat-rv-tint.11tydata.js. The sticky call bar sits AFTER the quote
# section on this page (see ARCHITECTURE/INVENTORY "slim" family gotcha).
permalink: boat-rv-tint.html
slug: boat-rv-tint
page_key: boat_rv_tint
og_image: images/hero.jpg
---
{%- set pg = pages.boat_rv_tint -%}
{%- set sh = pages.shared -%}
{% include "head/top.njk" %}

{% include "head/meta.njk" %}
{% set ld = schema_ld %}{% include "jsonld.njk" %}

{% include "css/main.njk" %}
{% include "css/slim-extra.njk" %}
{% include "css/page.njk" %}{% include "a11y-block.njk" %}
{% include "css/tail.njk" %}
{% include "head/clarity.njk" %}
</head>
<body>
{% include "skip-link.njk" %}
{% include "sprite.njk" %}
{% include "util.njk" %}
{% include "header.njk" %}
<main id="main" tabindex="-1">

<!-- UNIQUE:START boat-rv-tint -->
<div class="phero"><p class="crumb"><a href="/">{{ sh.crumb.home | safe }}</a> / <a href="/#services">{{ sh.crumb.services | safe }}</a> / {{ pg.hero.crumb | safe }}</p><h1>{{ pg.hero.heading | safe }}</h1>
  <p>{{ pg.hero.intro | safe }}</p>
  <div class="pbtns"><a class="qbtn" href="tel:{{ site.phone.tel | safe }}">{{ sh.buttons.call | safe }} {{ site.phone.display | safe }}</a><a class="qbtn" style="background:transparent;color:#fff;border:1.5px solid #6f7885" href="#quote">{{ pg.hero.quote_btn | safe }}</a></div>
</div>



<section><div class="wrap">
  <h2>{{ pg.need.heading | safe }}</h2>
  <p class="sub">{{ pg.need.sub | safe }}</p>
  <dl class="factlist">
{% for it in pg.need.items %}    <div>
      <dt>{{ it.term | safe }}</dt>
      <dd>{{ it.detail | safe }}</dd>
    </div>
{% endfor %}  </dl>
</div></section>

<section class="soft"><div class="wrap content">
{% for b in pg.diffjob.blocks %}  <div>
    <h2>{{ b.heading | safe }}</h2>
{% for p in b.paragraphs %}    <p>{{ p | safe }}</p>
{% endfor %}  </div>
{% endfor %}</div></section>

<section><div class="wrap">
  <h2>{{ pg.law.heading | safe }}</h2>
  <p class="sub" style="max-width:760px">{{ pg.law.sub | safe }}</p>
</div></section>

<section class="soft"><div class="wrap">
  <h2>{{ pg.season.heading | safe }}</h2>
  <p class="sub" style="max-width:760px">{{ pg.season.sub | safe }}</p>
  <div style="text-align:center"><a class="qbtn" href="tel:{{ site.phone.tel | safe }}">{{ pg.season.cta_prefix | safe }}{{ site.phone.display | safe }}</a></div>
</div></section>

<section><div class="wrap">
  <h2>{{ pg.also.heading | safe }}</h2>
  <div class="otherlinks">
{% for l in pg.also.links %}    <a href="{{ l.href | safe }}"><svg class="ic" aria-hidden="true"><use href="#{{ l.icon | safe }}"/></svg> {{ l.label | safe }}</a>
{% endfor %}  </div>
</div></section>

{% include "quote.njk" %}
<!-- UNIQUE:END boat-rv-tint -->

{% include "sticky-call.njk" %}
</main>
{% include "footer.njk" %}
{% include "js/burger.njk" %}
{% include "js/emailbtn.njk" %}
{% include "js/quote-submit.njk" %}
{% include "js/anim.njk" %}
{% include "js/source-vin.njk" %}
{% include "js/gtag-events.njk" %}
{% include "cookie-bar.njk" %}
{% include "js/cookie.njk" %}
{% include "js/svc-validate.njk" %}
</body>
</html>
