---
# Boat and RV window tint, v2 look. All wording is in _data/pages/boat_rv_tint.json; the page's own
# sections are printed here, after the layout's hero. Layout: _includes/layouts/service-v2.njk.
# JSON-LD: boat-rv-tint.11tydata.js. No real boat or RV photo exists, so the hero is type only.
layout: layouts/service-v2.njk
permalink: boat-rv-tint.html
slug: boat-rv-tint
page_key: boat_rv_tint
og_image: images/hero.jpg
---
{%- set pg = pages.boat_rv_tint -%}
<section class="v2-section" aria-labelledby="sv-need-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="sv-need-h">{{ pg.need.heading | safe }}</h2>
      <p class="sv-sub">{{ pg.need.sub | safe }}</p>
    </div>
    <dl class="sv-facts-list">
{%- for it in pg.need.items %}
      <div><dt>{{ it.term | safe }}</dt><dd>{{ it.detail | safe }}</dd></div>
{%- endfor %}
    </dl>
  </div>
</section>

<section class="v2-band v2-section" aria-label="{{ pg.hero.crumb | striptags | safe }}">
  <div class="v2-wrap sv-cols">
{%- for b in pg.diffjob.blocks %}
    <div class="sv-col"><h3>{{ b.heading | safe }}</h3>
{%- for p in b.paragraphs %}
      <p>{{ p | safe }}</p>
{%- endfor %}
    </div>
{%- endfor %}
  </div>
</section>

<section class="v2-section" aria-labelledby="sv-law-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <h2 class="v2-h2" id="sv-law-h">{{ pg.law.heading | safe }}</h2>
    <p class="sv-sub">{{ pg.law.sub | safe }}</p>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="sv-season-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <h2 class="v2-h2" id="sv-season-h">{{ pg.season.heading | safe }}</h2>
    <p class="sv-sub">{{ pg.season.sub | safe }}</p>
    <div class="sv-cta-row"><a class="v2-textlink" href="tel:{{ site.phone.tel | safe }}">{{ pg.season.cta_prefix | safe }}{{ site.phone.display | safe }}</a></div>
  </div>
</section>
