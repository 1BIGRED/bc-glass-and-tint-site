<body>
{% include "skip-link.njk" %}
{% include "sprite.njk" %}
{% include "util.njk" %}
{% include "header.njk" %}
<main id="main" tabindex="-1">

<section class="phero"><p class="crumb"><a href="/">{{ sh.crumb.home | safe }}</a> / <a href="/#services">{{ sh.crumb.services | safe }}</a> / {{ pg.hero.crumb | safe }}</p><h1>{{ pg.hero.heading | safe }}</h1><p>{{ pg.hero.intro | safe }}</p><div class="pbtns"><a class="qbtn" href="tel:{{ site.phone.tel | safe }}">{{ sh.buttons.call | safe }} {{ site.phone.display | safe }}</a><a class="qbtn" style="background:transparent;color:#fff;border:1.5px solid #6f7885" href="#quote">{{ sh.buttons.free_quote | safe }}</a></div><div class="ptrust"><span><b>{{ site.reviews.google_rating | safe }}★</b> {{ pg.ptrust.google_label | safe }}</span><span class="sep">|</span><span><b>{{ site.reviews.google_count | safe }}</b> {{ pg.ptrust.reviews_label | safe }}</span><span class="sep">|</span><span>{{ pg.ptrust.family_label | safe }} <b>{{ site.founding_year | safe }}</b></span><span class="sep">|</span><span>{{ pg.ptrust.warranty_label | safe }}</span></div></section>

<div class="band"><div class="wrap">{% for b in pg.band %}<span><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg> {{ b | safe }}</span>{% endfor %}</div></div>

<section><div class="wrap"><div class="content"><div class="pic"><img src="images/residential.webp" alt="{{ pg.section_film.image_alt | safe }}" loading="lazy" width="600" height="400"></div><div><h2>{{ pg.section_film.heading | safe }}</h2><p>{{ pg.section_film.intro | safe }}</p><ul>{% for li in pg.section_film.bullets %}<li>{{ li | safe }}</li>{% endfor %}</ul></div></div></div></section>

<section class="soft"><div class="wrap"><div class="content"><div><h2>{{ pg.section_blinds.heading | safe }}</h2><p>{{ pg.section_blinds.intro | safe }}</p><ul>{% for li in pg.section_blinds.bullets %}<li>{{ li | safe }}</li>{% endfor %}</ul></div><div class="pic"><img src="images/blinds.webp" alt="{{ pg.section_blinds.image_alt | safe }}" loading="lazy" width="600" height="400"></div></div></div></section>

<section><div class="wrap"><h2>{{ pg.steps.heading | safe }}</h2><p class="sub">{{ pg.steps.sub | safe }}</p><div class="steps">{% for s in pg.steps.items %}<div class="step"><div class="num">{{ loop.index }}</div><div><h3>{{ s.title | safe }}</h3><p>{{ s.text | safe }}</p></div></div>{% endfor %}</div></div></section>

<section class="soft"><div class="wrap"><h2>{{ pg.needs.heading | safe }}</h2><p class="sub">{{ pg.needs.sub | safe }}</p><div class="minigrid">{% for c in pg.needs.cards %}<a class="minicard" href="{{ c.href | safe }}"><svg class="ic" aria-hidden="true"><use href="#{{ c.icon | safe }}"/></svg><div><b>{{ c.title | safe }}</b><span>{{ c.text | safe }}</span></div></a>{% endfor %}</div></div></section>

<section><div class="wrap"><h2>{{ pg.communities.heading | safe }}</h2><p class="sub">{{ pg.communities.sub | safe }}</p><div class="communities">{% for c in pg.communities.items %}<div class="commcard"><h3><svg class="ic" aria-hidden="true"><use href="#i-house"/></svg> {{ c.name | safe }}</h3><div class="who">{{ c.builder | safe }}</div><p>{{ c.text | safe }}</p></div>{% endfor %}</div><p class="sub" style="margin:26px auto 0">{{ pg.communities.closing | safe }}</p></div></section>

<section class="soft"><div class="wrap"><h2>{{ pg.why.heading | safe }}</h2><p class="sub">{{ pg.why.sub | safe }}</p><div class="why">{% for w in pg.why.items %}<div class="item"><svg class="ic" aria-hidden="true"><use href="#{{ w.icon | safe }}"/></svg><div><h3>{{ w.title | safe }}</h3><p>{{ w.text | safe }}</p></div></div>{% endfor %}</div></div></section>

<section><div class="wrap"><h2>{{ pg.reviews.heading | safe }}</h2><p class="sub">{{ pg.reviews.sub | fill | safe }}</p><div class="revgrid">{% for r in pg.reviews.items %}<div class="rev"><div class="vbadge"><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg> {{ sh.reviews.google_badge | safe }}</div><div class="st" role="img" aria-label="{{ sh.reviews.stars_label | safe }}"><svg class="ic" aria-hidden="true"><use href="#i-star"/></svg><svg class="ic" aria-hidden="true"><use href="#i-star"/></svg><svg class="ic" aria-hidden="true"><use href="#i-star"/></svg><svg class="ic" aria-hidden="true"><use href="#i-star"/></svg><svg class="ic" aria-hidden="true"><use href="#i-star"/></svg></div><div class="qt">"{{ r.quote | safe }}"</div><div class="by">{{ r.name | safe }}</div></div>{% endfor %}</div><div class="revlink"><a href="/reviews">{{ pg.reviews.more_link | safe }}</a></div></div></section>

<section class="soft"><div class="wrap"><h2>{{ pg.faq.heading | safe }}</h2><p class="sub">{{ pg.faq.sub_lead | safe }}{{ site.phone.display | safe }}{{ pg.faq.sub_tail | safe }}</p><div class="faq2">{% for item in pg.faq.items %}<div class="item"><h3 class="q">{{ item.question | safe }}</h3><div class="a">{{ item.answer | safe }}</div></div>{% endfor %}<div class="more"><a href="/qa">{{ pg.faq.more_label | safe }}</a></div></div></div></section>

{% include "quote.njk" %}

{% include "sticky-call.njk" %}
</main>
{% include "footer.njk" %}
{% include "js/burger.njk" %}
{% include "js/emailbtn.njk" %}
{% include "js/quote-submit.njk" %}
{% include "js/anim.njk" %}
{% include "js/source-vin.njk" %}
{% include "js/gtag-events.njk" %}
{% include "cookie-bar.njk" %}
{% include "js/cookie.njk" %}
{% include "js/svc-validate.njk" %}
</body>
</html>
