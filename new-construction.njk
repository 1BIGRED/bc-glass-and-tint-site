---
# New construction landing page, v2 Warm Gallery (website overhaul, 2026-10-29). Layout:
# _includes/layouts/v2.njk with theme: warm. Styles: assets/v2/v2.css plus assets/v2/pages.css.
# Wording: _data/pages/new_construction.json. Claims gates kept: no prices of any kind, never
# "prices are already worked out", the builder-independence line stays with the builder names,
# never any "communities rising" or growth framing. Real BC photos only (the old stock photos
# are gone). JSON-LD: new-construction.11tydata.js (one graph: Service, business, WebSite,
# WebPage, FAQPage built from the visible faq.items, BreadcrumbList).
layout: layouts/v2.njk
theme: warm
extra_css: ["/assets/v2/pages.css"]
permalink: new-construction.html
slug: new-construction
page_key: new_construction
og_image: images/hero.jpg
---
{%- set pg = pages.new_construction -%}
{%- set sh = pages.shared -%}
{%- set tel = site.phone.tel -%}
{%- set callText = sh.v2.call + " " + site.phone.display_call -%}
{%- set photo = null -%}
{%- for it in gallery.items %}{% if it.id == "home-sliding-window-backyard-tree" %}{% set photo = it %}{% endif %}{% endfor -%}

<section class="pg-head" aria-labelledby="pg-h1">
  <div class="v2-wrap pg-head__in">
    <div class="pg-head__copy">
      <nav class="pg-crumb" aria-label="Breadcrumb"><a href="/">{{ sh.crumb.home | safe }}</a><span aria-hidden="true">/</span><a href="/#services">{{ sh.crumb.services | safe }}</a><span aria-hidden="true">/</span><span>{{ pg.hero.crumb | safe }}</span></nav>
      <p class="v2-eyebrow">{{ pg.hero.eyebrow | safe }}</p>
      <h1 class="pg-h1" id="pg-h1">{{ pg.hero.heading | safe }}</h1>
      <p class="pg-lede">{{ pg.hero.intro | safe }}</p>
      <div class="pg-actions">
        <a class="v2-btn v2-btn--gold v2-btn--xl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
        <a class="v2-textlink" href="#quote">{{ sh.buttons.free_quote | safe }}</a>
      </div>
      <p class="v2-small">{{ site.reviews.google_rating | safe }} {{ pg.ptrust.google_label | safe }} · {{ site.reviews.google_count | safe }} {{ pg.ptrust.reviews_label | safe }} · {{ pg.ptrust.family_label | safe }} {{ site.founding_year | safe }} · {{ pg.ptrust.warranty_label | safe }}</p>
    </div>
{%- if photo %}
    <figure class="pg-photo">
      <picture><img src="/{{ photo.img1280 }}" srcset="/{{ photo.img640 }} {{ photo.w640 }}w, /{{ photo.img1280 }} {{ photo.w }}w" sizes="(min-width: 1024px) 520px, 100vw" width="{{ photo.w }}" height="{{ photo.h }}" alt="{{ pg.section_film.image_alt | safe }}" fetchpriority="high" decoding="async"></picture>
    </figure>
{%- endif %}
  </div>
</section>

<div class="pg-strip">
  <div class="v2-wrap">
    <ul>{% for b in pg.band %}<li>{{ b | safe }}</li>{% endfor %}</ul>
  </div>
</div>

<section class="v2-section" aria-labelledby="film-h">
  <div class="v2-wrap pg-cols">
    <div class="v2-stack">
      <h2 class="v2-h2" id="film-h">{{ pg.section_film.heading | safe }}</h2>
      <p class="v2-body">{{ pg.section_film.intro | safe }}</p>
    </div>
    <ul class="pg-list">
{%- for li in pg.section_film.bullets %}
      <li>{{ li | safe }}</li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="blinds-h">
  <div class="v2-wrap pg-cols">
    <div class="v2-stack">
      <h2 class="v2-h2" id="blinds-h">{{ pg.section_blinds.heading | safe }}</h2>
      <p class="v2-body">{{ pg.section_blinds.intro | safe }}</p>
    </div>
    <ul class="pg-list">
{%- for li in pg.section_blinds.bullets %}
      <li>{{ li | safe }}</li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="v2-section" aria-labelledby="steps-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="steps-h">{{ pg.steps.heading | safe }}</h2>
      <p class="v2-body">{{ pg.steps.sub | safe }}</p>
    </div>
    <ol class="pg-steps">
{%- for s in pg.steps.items %}
      <li><h3 class="pg-h3">{{ s.title | safe }}</h3><p>{{ s.text | safe }}</p></li>
{%- endfor %}
    </ol>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="needs-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="needs-h">{{ pg.needs.heading | safe }}</h2>
      <p class="v2-body">{{ pg.needs.sub | safe }}</p>
    </div>
    <ul class="pg-links">
{%- for c in pg.needs.cards %}
      <li><a href="{{ c.href | safe }}"><span class="pg-links__t">{{ c.title | safe }}</span><span class="pg-links__s">{{ c.text | safe }}</span></a></li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="v2-section" aria-labelledby="comm-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="comm-h">{{ pg.communities.heading | safe }}</h2>
      <p class="v2-body">{{ pg.communities.sub | safe }}</p>
    </div>
    <ul class="pg-threecol">
{%- for c in pg.communities.items %}
      <li><h3 class="pg-h3">{{ c.name | safe }}</h3><p class="pg-who">{{ c.builder | safe }}</p><p>{{ c.text | safe }}</p></li>
{%- endfor %}
    </ul>
    <p class="v2-small">{{ pg.communities.closing | safe }}</p>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="why-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="why-h">{{ pg.why.heading | safe }}</h2>
      <p class="v2-body">{{ pg.why.sub | safe }}</p>
    </div>
    <ul class="pg-values">
{%- for w in pg.why.items %}
      <li><h3 class="pg-h3">{{ w.title | safe }}</h3><p>{{ w.text | safe }}</p></li>
{%- endfor %}
    </ul>
  </div>
</section>

<section class="v2-section" aria-labelledby="reviews-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="reviews-h">{{ pg.reviews.heading | safe }}</h2>
      <p class="v2-body">{{ pg.reviews.sub | fill | safe }}</p>
    </div>
    <div class="pg-quotes">
{%- for r in pg.reviews.items %}
      <blockquote class="pg-quote"><p>"{{ r.quote | safe }}"</p><footer>{{ r.name | safe }}, {{ pg.reviews.label | safe }}</footer></blockquote>
{%- endfor %}
    </div>
    <p><a class="v2-link" href="/reviews">{{ pg.reviews.more_link | safe }}</a></p>
  </div>
</section>

<section class="v2-band v2-section" id="faq" aria-labelledby="faq-h">
  <div class="v2-wrap v2-faq">
    <h2 class="v2-h2" id="faq-h">{{ pg.faq.heading | safe }}</h2>
    <p class="v2-body">{{ pg.faq.sub_lead | safe }}<a href="tel:{{ tel | safe }}">{{ site.phone.display | safe }}</a>{{ pg.faq.sub_tail | safe }}</p>
    <div class="v2-faq__list">
{%- for item in pg.faq.items %}
      <details class="v2-faq__item">
        <summary><h3 class="v2-faq__q">{{ item.question | safe }}</h3><span class="v2-faq__plus" aria-hidden="true"></span></summary>
        <div class="v2-faq__a"><p>{{ item.answer | safe }}</p></div>
      </details>
{%- endfor %}
    </div>
    <p class="v2-small"><a href="/qa">{{ pg.faq.more_label | safe }}</a></p>
  </div>
</section>

{%- set week = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] %}
{%- set closedDays = [] %}
{%- for d in week %}{% if not (d in site.hours.days) %}{% set _n = closedDays.push(d) %}{% endif %}{% endfor %}
<section class="v2-band v2-section v2-contactwrap" aria-labelledby="contact-h">
  <div class="v2-wrap v2-contact">
    <div class="v2-contact__talk">
      <h2 class="v2-h2 v2-h2--xl" id="contact-h">{{ pg.contact.heading | safe }}</h2>
      <a class="v2-btn v2-btn--gold v2-btn--xxl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
      <span class="v2-status v2-status--lg" data-bc-status><span class="v2-dot" aria-hidden="true"></span><span class="v2-status__txt"></span></span>
      <p class="v2-body">{{ site.address.display | safe }}<br>{{ site.hours.display | safe }}.{% if closedDays.length %} {{ pg.contact.closed_prefix | safe }} {{ closedDays | join(" and ") }}.{% endif %}</p>
    </div>
    <div class="v2-contact__form">
{% include "quote.njk" %}
    </div>
  </div>
</section>
