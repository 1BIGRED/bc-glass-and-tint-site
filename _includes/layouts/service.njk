{#- Service page layout: auto-tint, blinds, ceramic-coating, chip-repair, clear-bra,
    commercial-film, home-tint, windshield. The page template is front matter only (plus,
    for blinds, the extra sections in its body, printed after the content section).
    Wording: _data/pages/<page_key>.json. Structure (images, icons, anchors): front matter.
    JSON-LD: the page's <slug>.11tydata.js builds schema_ld from lib/schema.js. -#}
{%- from "macros.njk" import reviewCard -%}
{%- set pg = pages[page_key] -%}
{%- set sh = pages.shared -%}
{%- set ybadge = (frame[slug] or {}).yelp_badge or "inline" -%}
{% include "head/top.njk" %}

{% include "head/meta.njk" %}
{% set ld = schema_ld %}{% include "jsonld.njk" %}

{% include "css/main.njk" %}
{% include "css/page.njk" %}{% include "a11y-block.njk" %}
{% include "css/tail.njk" %}
{% include "head/clarity.njk" %}
</head>
<body>
{% include "skip-link.njk" %}
{% include "sprite.njk" %}
{% include "util.njk" %}
{% include "header.njk" %}
<main id="main" tabindex="-1">
<section class="phero"><p class="crumb"><a href="/">{{ sh.crumb.home | safe }}</a> / <a href="/#services">{{ sh.crumb.services | safe }}</a> / {{ pg.hero.crumb | safe }}</p><h1>{{ pg.hero.heading | safe }}</h1>{% if pg.hero.note %}<p class="chipnote">{{ pg.hero.note | safe }}</p>{% endif %}<p>{{ pg.hero.intro | fill | safe }}</p><div class="pbtns"><a class="qbtn" href="tel:{{ site.phone.tel | safe }}">{{ sh.buttons.call | safe }} {{ site.phone.display | safe }}</a><a class="qbtn" style="background:transparent;color:#fff;border:1.5px solid #6f7885" href="#quote">{{ sh.buttons.free_quote | safe }}</a></div>{% if pg.hero.chooser %}<p class="sub" style="margin-top:26px;color:#c9ccd1">{{ pg.hero.chooser.prompt | safe }}</p><div class="pbtns" style="margin-top:10px">{% for b in pg.hero.chooser.buttons %}<a class="qbtn" style="background:transparent;color:#fff;border:1.5px solid #6f7885" href="{{ b.href | safe }}">{{ b.label | safe }}</a>{% endfor %}</div>{% endif %}</section>
<div class="band"><div class="wrap">{% for b in pg.band %}<span><svg class="ic" aria-hidden="true"><use href="#i-check"/></svg> {{ b | safe }}</span>{% endfor %}</div></div>
<section><div class="wrap"><div class="content"><div class="pic skel"><img class="lazyimg" loading="lazy" alt="{{ pg.content.image_alt | safe }}" src="{{ content_image | safe }}" width="{{ content_image_width | safe }}" height="{{ content_image_height | safe }}"></div><div><div class="chead" style="margin-bottom:6px"><svg class="ic" aria-hidden="true" style="width:28px;height:28px;color:var(--gold)"><use href="#{{ content_icon | safe }}"/></svg><h2{% if content_heading_id %} id="{{ content_heading_id | safe }}"{% endif %}>{{ pg.content.heading | safe }}</h2></div><p>{{ pg.content.intro | fill | safe }}</p>{% if pg.content.note %}<p style="color:var(--mut)">{{ pg.content.note | fill | safe }}</p>{% endif %}<ul>{% for li in pg.content.bullets %}<li>{{ li | fill | safe }}</li>{% endfor %}</ul>{% if pg.content.footnote %}<p style="font-size:13.5px;color:var(--mut);margin-top:10px">{{ pg.content.footnote | fill | safe }}</p>{% endif %}<a class="qbtn" href="#quote" style="margin-top:10px">{{ sh.buttons.free_quote | safe }}</a></div></div></div></section>
{{ content | safe }}<section{% if reviews_soft %} class="soft"{% endif %}><div class="wrap"><h2>{{ pg.reviews.heading | safe }}</h2><p class="sub">{{ pg.reviews.sub | fill | safe }}</p><div class="revgrid">{% for r in pg.reviews.items %}{{ reviewCard(r, ybadge, sh.reviews) }}{% endfor %}</div><div style="text-align:center;margin-top:24px"><a href="/reviews" style="color:var(--goldsm);font-weight:800;font-size:14px">{{ sh.reviews.more_link | safe }}</a></div></div></section>
<section class="soft"><div class="wrap"><h2 style="text-align:center">{{ sh.service_also.heading | safe }}</h2><p class="sub">{{ sh.service_also.sub_intro | safe }}<a href="/qa" style="color:var(--goldsm);font-weight:700">{{ sh.service_also.sub_link | safe }}</a>{{ sh.service_also.sub_outro | safe }}</p><div class="otherlinks">{% for l in pg.also.links %}{% if not loop.first and not l.same_line %}
{% endif %}<a href="{{ l.href | safe }}"><svg class="ic" aria-hidden="true"><use href="#{{ l.icon | safe }}"/></svg> {{ l.label | safe }}</a>{% endfor %}</div></div></section>
{% include "quote.njk" %}
{% include "sticky-call.njk" %}
</main>
{% include "footer.njk" %}
{% include "js/burger.njk" %}
{% include "js/lazyimg.njk" %}
{% include "js/emailbtn.njk" %}
{% include "js/quote-submit.njk" %}
{% include "js/anim.njk" %}
{% include "js/source-vin.njk" %}
{% include "js/gtag-events.njk" %}
{% include "cookie-bar.njk" %}
{% include "js/cookie.njk" %}
{% include "js/svc-validate.njk" %}
</body>
</html>
