{#- v2 macros. Import with: {% from "v2/macros.njk" import pic, galleryPic %}

    pic(im, alt, sizes, cls, opts): a responsive <picture> from one _data/v2images.json entry
      (AVIF, WebP, JPEG). opts.eager true = no lazy loading; opts.high true = fetchpriority high.
      width and height are always printed so the browser reserves the space (no layout shift).
    galleryPic(it, sizes, cls): an image from one _data/gallery.json item (640 and 1280 JPEG). -#}
{% macro pic(im, alt, sizes, cls, opts) -%}
{%- set o = opts or {} -%}
<picture><source type="image/avif" srcset="{{ im.avif }}" sizes="{{ sizes }}"><source type="image/webp" srcset="{{ im.webp }}" sizes="{{ sizes }}"><img{% if cls %} class="{{ cls }}"{% endif %} src="{{ im.fallback }}" srcset="{{ im.jpeg }}" sizes="{{ sizes }}" width="{{ im.width }}" height="{{ im.height }}" alt="{{ alt | safe }}"{% if o.high %} fetchpriority="high"{% endif %}{% if not o.eager %} loading="lazy" decoding="async"{% endif %}></picture>
{%- endmacro %}

{% macro galleryPic(it, sizes, cls, alt) -%}
<img{% if cls %} class="{{ cls }}"{% endif %} src="/{{ it.img640 }}" srcset="/{{ it.img640 }} {{ it.w640 }}w, /{{ it.img1280 }} {{ it.w }}w" sizes="{{ sizes }}" width="{{ it.w }}" height="{{ it.h }}" alt="{{ (alt if alt is defined else it.alt) | safe }}" loading="lazy" decoding="async">
{%- endmacro %}
