{#- Managed accessibility block. This partial replaces the studio script scripts\Fix-SiteA11y.ps1 for
    this site: edit the rules HERE, never in the built pages. The start and end marker comments are kept
    because the live pages carry them. Per-page switches: frame[slug].a11y. -#}
{%- set a = frame[slug].a11y or {} -%}
{% if a.start_marker %}/* ==== a11y-managed-block v1 : generated by scripts\Fix-SiteA11y.ps1, do not hand-edit ==== */
{% endif %}{% if a.stickycall_base %}.stickycall{position:fixed;bottom:0;left:0;right:0;z-index:70;background:var(--gold);color:#1f2228;text-align:center;font-weight:800;padding:14px;font-size:16px;display:none;align-items:center;justify-content:center;gap:8px}@media(max-width:760px){body{padding-bottom:54px}.stickycall{display:flex}}{% endif %}:root{--goldd:#A8862F;--goldsm:#7c6427}/*--tipdelay*/[data-tip]:hover::after,[data-tip]:hover::before,[data-tip]:focus-visible::after,[data-tip]:focus-visible::before{transition-delay:.45s}/*--a11y-r5b*/[data-tip].tipshow::after,[data-tip].tipshow::before{display:block}footer>a,.crumb a,.qnote a,.hp+p a{display:inline-block;padding:4px 2px;line-height:1.6}.lmore{display:inline-flex}{% if a.carousel_dots %}/*--a11y-r5*/.carousel .dot{border:0;padding:9px 0;background-clip:content-box;cursor:pointer;box-sizing:content-box;min-width:24px;min-height:6px}.carousel .dot:focus-visible{outline:3px solid #fff;outline-offset:2px}{% endif %}/*--a11y-r4b*/footer .fcols p a{display:inline-block;padding:4px 2px;line-height:1.6}footer .fcols p{line-height:2}/*--a11y-r4*/.hero .badge{background:#2A2417}.band a:focus-visible,.stickycall a:focus-visible{outline-color:#1f2228}.hero a:focus-visible{outline-color:#ffffff}.rdots .rnav:hover{border-color:#8C6B14}.lbtn:hover{border-color:#8C6B14}form ::placeholder{color:#6B7178;opacity:1}h2,h3{line-height:1.2}.phero p{text-align:left}@media(max-width:760px){.phero h1{font-size:24px}}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #8C6B14;outline-offset:2px}.stickycall .sc:focus-visible{outline:3px solid #1f2228;outline-offset:-3px}.rdots .rdot{background:#767676}.rdots .rdot.on{background:#7c6427}.rcard .st .ic,.rev .st .ic{fill:#9a7413;stroke:#9a7413}html{scroll-padding-top:72px;scroll-padding-bottom:64px}@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms !important;transition-duration:.01ms !important;animation-iteration-count:1 !important}html{scroll-behavior:auto}}
h2 span,.brand span,.cat span,.rhead h2 span,.revstrip .rhead h2 span{color:var(--goldd) !important}
.sub a,.lbtn,.lmore,.revlink a,.revbadge .rb-score,.rdots .rnav,
.content a,.plannote a,.commcard .who,.yelphead strong,.plangroup h3,
main > p > a,nav.main a[style]{color:var(--goldsm) !important}
.qbtn:not([style*="color"]),.faq2 .more a:not([style*="color"]),.more a:not([style*="color"]),
.callbtn:not([style*="color"]),.send:not([style*="color"]),.qsmall:not([style*="color"]),
.tbtn:not([style*="color"]){color:#1f2228 !important}
.mtrust .sep{color:#868e97 !important}
.plandisc,.indie{color:#5d666f !important}
.brand{white-space:nowrap}
nav.main a[style*="--goldsm"]{background:#F7EFD8;color:#6B5410 !important;padding:5px 10px;
  border-radius:6px;line-height:1.15}
.util a{padding:5px 0}
.revlink a,.sub a,.lmore{display:inline-block;padding-top:5px;padding-bottom:5px}
.rdots .rnav{min-width:34px;min-height:34px}
.rdots .rdot{padding:8px}
.wrap div > a:only-child{display:inline-block;padding-top:5px;padding-bottom:5px}
.stickycall{gap:0;padding:0}
.stickycall .sc{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;padding:14px 6px;color:#1f2228 !important;text-decoration:none}
.stickycall .sc+.sc{border-left:2px solid rgba(31,34,40,.28)}
.phero p,.chero p,.hero p.sub{max-width:64ch;margin-left:auto;margin-right:auto}
[data-tip]::after,[data-tip]::before{content:none}
[data-tip]:hover::after,[data-tip]:focus-visible::after,[data-tip].tipshow::after{content:attr(data-tip);opacity:1;transform:translateX(-50%) translateY(0)}
[data-tip]:hover::before,[data-tip]:focus-visible::before,[data-tip].tipshow::before{content:"";opacity:1;transform:translateX(-50%) translateY(0)}
/* ==== end a11y-managed-block v1 ==== */