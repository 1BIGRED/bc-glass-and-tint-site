<!-- Google tag (gtag.js), consent-gated -->
<script>document.documentElement.classList.add('js');/* peak pass R1 (technical 3): JS-only controls ([data-js-only]) show from first paint, no late shift */
(function(){var K='bcgt_analytics',ID='{{ site.ga4_id | safe }}',v=null;
try{v=localStorage.getItem(K)}catch(e){}
if(!v){try{var m=document.cookie.match(/(?:^|;\s*)bcgt_analytics=(yes|no)/);if(m)v=m[1];}catch(e){}}
window.__bcgtConsent=v;
/* peak pass R1 (technical 2, part A request 1): with no stored choice the cookie bar shows from first paint (CSS in 35-consent.css), so it is never a late LCP */
if(!v)document.documentElement.setAttribute('data-ck','open');
window.dataLayer=window.dataLayer||[];
window.gtag=function(){dataLayer.push(arguments)};
/* Consent Mode v2. We run Google Ads for conversion measurement only, no remarketing
   and no personalized ads. ad_storage and ad_user_data follow the same visitor choice
   as analytics_storage. ad_personalization stays denied so no ad profile is built. */
gtag('consent','default',{ad_storage:(v==='no'?'denied':'granted'),ad_user_data:(v==='no'?'denied':'granted'),ad_personalization:'denied',analytics_storage:(v==='no'?'denied':'granted'),wait_for_update:500});
gtag('set','ads_data_redaction',true);
gtag('set','url_passthrough',true);
window.__bcgtLoadGa=function(){if(window.__bcgtGaLoaded)return;window.__bcgtGaLoaded=true;
gtag('js',new Date());
gtag('config',ID,{allow_google_signals:false,allow_ad_personalization_signals:false});
{%- set adsId = site.google_ads_id | validAdsId -%}
{%- if adsId %}
gtag('config','{{ adsId }}');
{%- endif %}
var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id='+ID;
document.head.appendChild(s);};
{%- if noindex or not analytics %}
/* Not a production build (staging BC_NOINDEX=1, a Netlify deploy preview or branch deploy, a local build) or a noindex page: never send analytics or ad data. */
window['ga-disable-'+ID]=true;window.__bcgtLoadGa=function(){};
{%- else %}
if(v==='no'){window['ga-disable-'+ID]=true;}else{window.__bcgtLoadGa();}
{%- endif %}})();</script>