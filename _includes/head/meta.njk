{#- robots, title, description, canonical, Open Graph and Twitter tags.
    Wording comes from the page file: pages[page_key].meta.title / .description / .image_alt.
    The image comes from front matter (og_image, optional og_image_width / og_image_height).
    index.html alone carries the google-site-verification tag (frame[slug].gsv; keep it). -#}
{%- set fr = frame[slug] or {} -%}
{%- set m = pages[page_key].meta -%}
{%- set url = site.url if slug == "index" else site.origin + "/" + slug -%}
<meta name="robots" content="index, follow">
{% if fr.gsv %}<meta name="google-site-verification" content="{{ site.google_site_verification | safe }}" />
{% endif %}<title>{{ m.title | fill | safe }}</title>
<meta name="description" content="{{ m.description | fill | safe }}">
<link rel="canonical" href="{{ url | safe }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{% if fr.og_site_name_raw %}{{ site.name | safe }}{% else %}{{ site.name_html | safe }}{% endif %}">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="{{ m.title | fill | safe }}">
<meta property="og:description" content="{{ m.description | fill | safe }}">
<meta property="og:url" content="{{ url | safe }}">
<meta property="og:image" content="{{ site.origin | safe }}/{{ og_image | safe }}">
{% if og_image_width %}<meta property="og:image:width" content="{{ og_image_width | safe }}">
<meta property="og:image:height" content="{{ og_image_height | safe }}">
{% endif %}<meta property="og:image:alt" content="{{ m.image_alt | safe }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ m.title | fill | safe }}">
<meta name="twitter:description" content="{{ m.description | fill | safe }}">
<meta name="twitter:image" content="{{ site.origin | safe }}/{{ og_image | safe }}">