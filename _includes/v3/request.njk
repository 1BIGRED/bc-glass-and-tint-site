{#- The one request form (engineering 3.3; blueprint 5.4; art direction F-a to F-e). Owner: WS3.
    Same field set on /book, in every contact block and on the builder result. The form name stays
    "quote": it is the live Netlify form with its submission history and notification (engineering
    E1). Every field is in the static HTML (scripts only set values) so Netlify registers all of them.

    Import:
      {% from "v3/request.njk" import requestForm with context %}
    Call:
      {{ requestForm({ source: "home-contact", service: "car", id: "rq", netlify: true }) }}
    Parameters (one object):
      source   value of the hidden "source" field (the page or block the form sits in)
      service  preselected option: "car" | "home" | "blinds" | "chip" | "other" (optional)
      id       id prefix for the fields, so two forms on one page never share ids (default "rq")
      netlify  false drops data-netlify and netlify-honeypot (the smoke page uses it, so a demo
               copy can never register or change the live form's fields); default true

    Wording: _data/pages/book.json (form, success). Consent sentence: pages.shared.quote.consent_*
    (the approved C-028 wording, quoted by the privacy policy). Phone and hours: _data/site.json,
    through the rqFill filter (lib/eleventy-ws3.js).

    Behavior: assets/v3/js/40-request.js (core bundle). Styles: assets/v3/css/book/ (the "book"
    bundle). A page that includes this form does not have to list bundles: ["book"]; the macro adds
    the stylesheet link itself when the page has not.

    Markup contract the script and the tests rely on (do not rename):
      form.v3-request[data-rq]           the form; name="quote"
      [data-rq-err="name|phone|service"] one error paragraph per required field, wording server side
      [data-rq-fail]                     the send-failed message (role alert), wording server side
      [data-rq-sent]                     the success panel (role status), filled by script
      [data-rq-recap="service|build|days|ref"] rows in the success panel
      [data-rq-days-note]                the aria-live note for the two-day limit
      [data-rq-build-note]               shown when a valid ?b= code was applied
    Success wording, hours and phone are all printed here; the script only unhides and fills.
    No-JS: the form posts natively to /book/sent/ (a real page); Netlify records the submission. -#}
{% macro requestForm(opts) -%}
{%- set o = opts or {} -%}
{%- set id = o.id or "rq" -%}
{%- set useNetlify = (o.netlify !== false) -%}
{%- set f = pages.book.form -%}
{%- set sx = pages.book.success -%}
{%- set q = pages.shared.quote -%}
{%- if assetsHash.css.book and not ("book" in (bundles or [])) %}<link rel="stylesheet" href="{{ assetsHash.css.book }}">
{% endif -%}
<form class="v3-request" id="{{ id }}-form" name="quote" method="POST" action="/book/sent/"{% if useNetlify %} data-netlify="true" netlify-honeypot="bot-field"{% endif %} data-clarity-mask="true" data-rq data-rq-id="{{ id }}">
  <input type="hidden" name="form-name" value="quote">
  <input type="hidden" name="subject" value="Website request">
  <input type="hidden" name="ref" value="">
  <input type="hidden" name="build_code" value="">
  <input type="hidden" name="source" value="{{ o.source or '' }}">
  <input type="hidden" name="status_state" value="">
  <input type="hidden" name="utm_source" value="">
  <input type="hidden" name="utm_medium" value="">
  <input type="hidden" name="utm_campaign" value="">
  <input type="hidden" name="gclid" value="">
  <input type="hidden" name="lead_source" value="">
  <p class="vh" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

  <p class="rq-build-note t-label" data-rq-build-note hidden>{{ f.build_note | safe }}</p>

  <div class="rq-field">
    <label class="rq-label" for="{{ id }}-name">{{ f.name_label | safe }}</label>
    <input class="rq-input" id="{{ id }}-name" name="name" type="text" autocomplete="name" autocapitalize="words" enterkeyhint="next" required>
    <p class="rq-err" id="{{ id }}-name-err" data-rq-err="name" hidden>{{ f.name_error | safe }}</p>
  </div>

  <div class="rq-field">
    <label class="rq-label" for="{{ id }}-phone">{{ f.phone_label | safe }}</label>
    <input class="rq-input" id="{{ id }}-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" required>
    <p class="rq-err" id="{{ id }}-phone-err" data-rq-err="phone" hidden>{{ f.phone_error | safe }}</p>
  </div>

  <div class="rq-field">
    <label class="rq-label" for="{{ id }}-svc">{{ f.service_label | safe }}</label>
    <select class="rq-input rq-select" id="{{ id }}-svc" name="service" required>
      <option value="">{{ f.service_placeholder | safe }}</option>
{%- for s in f.services %}
      <option value="{{ s.value | safe }}" data-key="{{ s.key }}"{% if o.service == s.key %} selected{% endif %}>{{ s.value | safe }}</option>
{%- endfor %}
    </select>
    <p class="rq-err" id="{{ id }}-svc-err" data-rq-err="service" hidden>{{ f.service_error | safe }}</p>
  </div>

  <div class="rq-field">
    <label class="rq-label" for="{{ id }}-details">{{ f.details_label | safe }} <span class="rq-opt">({{ f.optional | safe }})</span></label>
    <textarea class="rq-input rq-textarea" id="{{ id }}-details" name="details" rows="4" maxlength="1200" aria-describedby="{{ id }}-details-hint"></textarea>
    <p class="rq-hint t-label" id="{{ id }}-details-hint">{{ f.details_hint | safe }}</p>
  </div>

  <fieldset class="rq-days" data-rq-days data-limit-msg="{{ f.days_limit }}" data-closed-word="{{ f.days_closed }}">
    <legend class="rq-label">{{ f.days_legend | safe }} <span class="rq-opt">({{ f.optional | safe }})</span></legend>
    <p class="rq-hint t-label" id="{{ id }}-days-hint">{{ f.days_hint | safe }}</p>
    <div class="rq-chips">
{%- for dn in site.hours.days %}{% set sh = dn.slice(0, 3) %}
      <label class="rq-chip"><input class="rq-chip__in" type="checkbox" name="days" value="{{ sh }} AM" data-day="{{ sh }}"><span class="rq-chip__lbl">{{ dn }} {{ f.morning | safe }}</span></label>
      <label class="rq-chip"><input class="rq-chip__in" type="checkbox" name="days" value="{{ sh }} PM" data-day="{{ sh }}"><span class="rq-chip__lbl">{{ dn }} {{ f.afternoon | safe }}</span></label>
{%- endfor %}
    </div>
    <p class="rq-live t-label" role="status" aria-live="polite" data-rq-days-note></p>
  </fieldset>

  <p class="rq-consent t-label">{{ q.consent_intro | safe }}<a href="/privacy-policy">{{ q.consent_link | safe }}</a>{{ q.consent_outro | safe }}</p>

  <button class="rq-submit t-button" type="submit" data-gold-zone data-label="{{ f.submit }}" data-sending="{{ f.sending }}">{{ f.submit | safe }}</button>
  <p class="rq-fail" role="alert" data-rq-fail hidden>{{ f.send_error | rqFill(site) | safe }}</p>
</form>

<div class="rq-sent" data-rq-sent role="status" tabindex="-1" hidden>
  <p class="rq-sent__h t-h3">{{ sx.heading | safe }}</p>
  <p class="t-lead">{{ sx.lead | rqFill(site) | safe }}{% if site.lines and site.lines.request_confirm %} {{ site.lines.request_confirm | safe }}{% endif %}</p>
  <p class="t-body">{{ sx.not_booked | safe }}</p>
  <dl class="rq-recap">
    <div data-rq-recap="service" hidden><dt>{{ sx.service_label | safe }}</dt><dd></dd></div>
    <div data-rq-recap="build" hidden><dt>{{ sx.build_label | safe }}</dt><dd></dd></div>
    <div data-rq-recap="days" hidden><dt>{{ sx.days_label | safe }}</dt><dd></dd></div>
    <div data-rq-recap="ref" hidden><dt>{{ sx.ref_label | safe }}</dt><dd class="tnum"></dd></div>
  </dl>
  <p class="rq-ref-note t-label" data-rq-ref-note hidden>{{ sx.ref_note | safe }}</p>
  <p class="t-body">{{ sx.talk | rqFill(site) | safe }}</p>
</div>
{%- endmacro %}
