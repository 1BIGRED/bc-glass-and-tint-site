{#- v3 site footer (WS5; art direction 3.1 row 10): ink-1 ground, 1px line on top, the real logo
    (raster original, resized as a whole; never redrawn), address, hours, phone, the five main
    links, more links, the out-of-town pages, legal links and the gift card link. No badge wall,
    no social icon row. The phone number here is one of the two allowed hand-written tel: links
    (WS5 acceptance). Keep id "ckreopen": the consent script listens for it. Cookie choices is a button (it opens the
    cookie bar, it goes nowhere); .v3-linkbtn in 20-header.css makes it look like the links beside it.
    Wording: pages.sections.footer. Contact facts: site.json. Included once by layouts/v3.njk. -#}
{%- set F = pages.sections.footer -%}
{%- set logoAlt = (pages.shared.v3.actions.header.logo_alt if (pages.shared.v3 and pages.shared.v3.actions and pages.shared.v3.actions.header) else pages.shared.v2.logo_alt) -%}
<footer class="v3-footer ws5-footer mood-dark bg-ink-1 hair-top">
  <div class="wrap ws5-footer__grid">
    <div class="ws5-footer__brand">
      {%- set lg = images._logo if (images and images._logo) else { png: "/logo-hero.png", width: 640, height: 238 } %}
      {#- Same logo files as the header (AVIF and WebP at 107w, 214w, 321w, PNG fallback; peak pass T7). The
          footer logo is 40px tall at every width (60-sections.css), so 107px wide. -#}
      <a class="ws5-footer__logo" href="/"><picture><source type="image/avif" srcset="/images/v3/logo-107.avif 107w, /images/v3/logo-214.avif 214w, /images/v3/logo-321.avif 321w" sizes="107px"><source type="image/webp" srcset="/images/v3/logo-107.webp 107w, /images/v3/logo-214.webp 214w, /images/v3/logo-321.webp 321w" sizes="107px"><img class="v3-logo-img" src="{{ lg.png }}" width="{{ lg.width }}" height="{{ lg.height }}" alt="{{ logoAlt | safe }}" loading="lazy" decoding="async"></picture></a>
      <p class="fg-2 measure">{{ F.tagline | safe }}</p>
    </div>
    <div class="ws5-footer__visit">
      <p class="t-eyebrow">{{ F.visit_heading | safe }}</p>
      <p>{{ site.address.display | safe }}<br>{{ pages.sections.talk.hours | safe }}<br><a class="tnum" href="tel:{{ site.phone.tel | safe }}">{{ site.phone.display_call | safe }}</a></p>
    </div>
    <nav class="ws5-footer__nav" aria-label="{{ F.nav_label | safe }}">
      <ul class="list-plain">{% for l in F.main %}<li><a href="{{ l.href }}">{{ l.label | safe }}</a></li>{% endfor %}</ul>
      <ul class="list-plain">{% for l in F.more %}<li><a href="{{ l.href }}">{{ l.label | safe }}</a></li>{% endfor %}</ul>
      <div>
        <p class="t-eyebrow">{{ F.areas_heading | safe }}</p>
        <ul class="list-plain">{% for l in F.areas %}<li><a href="{{ l.href }}">{{ l.label | safe }}</a></li>{% endfor %}</ul>
      </div>
    </nav>
  </div>
  <div class="wrap ws5-footer__legal t-label fg-2">
    <p><a href="/privacy-policy">{{ F.privacy | safe }}</a> <span aria-hidden="true">&middot;</span> <button type="button" class="v3-linkbtn" id="ckreopen">{{ F.cookies | safe }}</button> <span aria-hidden="true">&middot;</span> <a href="{{ F.tint_law_href }}">{{ F.tint_law | safe }}</a></p>
    <p>&copy; {{ pages.shared.footer.copyright_year | safe }} {{ site.name_html | safe }}. {{ F.rights | safe }}</p>
  </div>
</footer>
