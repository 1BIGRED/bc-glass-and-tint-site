{#- Hero macros (WS5; overhaul v3). The media slot contract from phase A is kept as is:
      heroMedia(hero, { strip })  hero = { mode: "ramp" | "storefront" | "photo", image, alt, sizes, note }
    "photo" (Chase, 2026-10-29 10:03 PM: "Let's do the same picture as the current") is one
    art-directed image item, the parade frame today (images["parade-hero"], home.json
    v3.hero.photo_image). It is a low-resolution source (1200 px wide), so its CSS caps the shown
    width at the crop's own pixels (80 and home bundle CSS), never an upscale at 1x.
    "ramp" is the default and the fallback; storefront or photo without an image fall back to the ramp, so
    a missing photo never ships an empty box (CEO ruling; art direction 2.2 to 2.4, HF3). The
    storefront photo must be WS6's crop with the customer's Bronco fully out of frame; never a
    customer vehicle as the brand image (Chase note 1).

    homeHero(h, router)   the homepage hero (art direction 2.3 HL1 to HL8, blueprint 3.1)
    pageHero(o)           service, city and info page hero (art direction 3.2 item 1)
    Import WITH CONTEXT:  {% from "v3/hero.njk" import homeHero, pageHero, heroMedia with context %}

    No motion on load (HL8): nothing here animates. The hero never sits under the header: the
    header is sticky and holds its own height in the flow (layouts/v3.njk), so the hero starts
    below it (HL1). -#}
{%- from "v3/media.njk" import picture -%}
{%- from "v3/actions.njk" import action with context -%}

{% macro heroMedia(h, opts) -%}
{%- set o = opts or {} -%}
{%- set hh = h or {} -%}
{%- set isStore = (hh.mode == "storefront" and hh.image) -%}
{%- set isPhoto = (hh.mode == "photo" and hh.image) -%}
{%- if isPhoto %}
<figure class="v3-hero-media v3-hero-media--photo v3-hero-media--parade" data-hero-mode="photo">
  {{ picture(hh.image, hh.sizes or "100vw", { alt: hh.alt, high: true }) }}
{%- if hh.caption %}
  {#- Peak pass R1 (visual 2c): one line saying only what is in the frame, at every width. -#}
  <figcaption class="v3-hero-media__cap t-label fg-2">{{ hh.caption | safe }}</figcaption>
{%- elif hh.note %}
  <figcaption class="v3-hero-media__note">{{ hh.note | safe }}</figcaption>
{%- endif %}
</figure>
{%- elif isStore %}
<figure class="v3-hero-media v3-hero-media--storefront" data-hero-mode="storefront">
  {{ picture(hh.image, hh.sizes or "100vw", { alt: hh.alt, high: true }) }}
{%- if hh.note %}
  <figcaption class="v3-hero-media__note">{{ hh.note | safe }}</figcaption>
{%- endif %}
</figure>
{%- else %}
<figure class="v3-hero-media v3-hero-media--ramp" data-hero-mode="ramp">
  <div class="v3-ramp{% if o.strip %} v3-ramp--strip{% endif %}" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
{%- if hh.note %}
  <figcaption class="v3-hero-media__note">{{ hh.note | safe }}</figcaption>
{%- endif %}
</figure>
{%- endif %}
{%- endmacro %}

{#- The proof token beside the action (blueprint 3.1): the warranty line always; the Google line
    only from a fresh human read (site.reviews.google_as_of within 14 days of the build). -#}
{% macro proof(line) -%}
{%- set rv = site.reviews or {} -%}
<p class="ws5-proof t-label fg-2">{{ line | safe }}{% if rv.google_as_of and (rv.google_as_of | ws5fresh(14)) %} <a href="{{ reviews.listing_url | safe }}" target="_blank" rel="noopener">Google: {{ rv.google_rating }} from {{ rv.google_count }} reviews, read {{ (rv.google_as_of_label or rv.google_as_of) | safe }}</a>.{% endif %}</p>
{%- endmacro %}

{% macro homeHero(h, router) -%}
{%- set hh = h or {} -%}
<section class="ws5-hero ws5-hero--home mood-dark bg-ink-0" aria-labelledby="hero-h">
  <div class="ws5-hero__in">
    <div class="ws5-hero__copy">
      {{ eyebrowLine(hh.eyebrow, hh.eyebrow_short) }}
      <h1 id="hero-h">{{ hh.h1 | safe }}</h1>
      <p class="t-lead fg-2 ws5-hero__sub">{{ hh.sub | safe }}</p>
      <div class="ws5-hero__act">{{ action({ slot: "hero", service: "any" }) }}</div>
      <p class="v3-status v3-status--long ws5-hero__status" data-bc-status data-form="long"><span class="v3-status__dot" aria-hidden="true"></span><span class="v3-status__txt"></span></p>
      <nav class="ws5-router" aria-label="{{ hh.router_label | safe }}">
{%- for t in router %}
        <a class="ws5-route" href="{{ t.href }}" data-ev="router_click" data-path="{{ t.id }}">
          <span class="ws5-route__strip ws5-route__strip--{{ t.id }}" aria-hidden="true"></span>
          <span class="ws5-route__t">{{ t.label | safe }}</span>
          <span class="ws5-route__m">{{ t.micro | safe }}{% if t.draft %} <span class="v3-prow__draft t-label">{{ pages.sections.draft_label | safe }}</span>{% endif %}</span>
          <svg class="ws5-route__chev" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
{%- endfor %}
      </nav>
      {%- if hh.gift and hh.gift.show %}
      {#- Peak pass R2 (psychology R1 #10): one quiet gift card line under the router, printed only when the
          build falls inside home.json v3.hero.gift from/to (index.11tydata.js); 60-moments.js removes
          it for a visitor after the end date. Gift cards are only ever sold (decisions-and-rules line 61). -#}
      <p class="t-label ws5-hero__gift" data-season-to="{{ hh.gift.to }}"><a href="{{ hh.gift.href }}">{{ hh.gift.text | safe }}</a></p>
      {%- endif %}
      {%- if hh.review %}
      {#- Proof earlier (fixes B 2026-10-29): one verbatim Google review straight after the router, same
          markup as the "In their words." quote (no stars, no logo, no quote glyphs, no heading). -#}
      <figure class="ws5-quote ws5-quote--hero" data-review="{{ hh.review.id }}">
        <blockquote><p>{{ hh.review.text | safe }}</p></blockquote>
        <figcaption class="t-label fg-2"><a href="{{ (hh.review.url or reviews.listing_url) | safe }}" target="_blank" rel="noopener">{{ hh.review.author_display | safe }}{% if hh.review.month_year %}, {{ hh.review.month_year | safe }}{% endif %}, {{ pages.sections.words.attribution | safe }}</a></figcaption>
      </figure>
      {%- endif %}
      {#- Peak pass R1 (visual 6): the floating 13px warranty line is gone; the proof row below the
          hero (proofRow) carries it with the other facts on file. -#}
    </div>
    <div class="ws5-hero__media">
      {{ heroMedia(hh.media) }}
    </div>
  </div>
</section>
{%- endmacro %}

{#- Eyebrow with an optional phone form (peak pass R1, visual 14): caps longer than one line read as
    a label that ran out of room, so under 640px a short string of 30 characters or fewer shows
    instead. Only one of the two is ever displayed (display: none hides the other from screen
    readers too). -#}
{% macro eyebrowLine(long, short) -%}
{%- if short and short != long -%}
<p class="t-eyebrow"><span class="eb-long">{{ long | safe }}</span><span class="eb-short">{{ short | safe }}</span></p>
{%- elif long -%}
<p class="t-eyebrow">{{ long | safe }}</p>
{%- endif -%}
{%- endmacro %}

{#- Proof row (peak pass R1, visual 6): homepage section 2, facts on file only, never a review count or
    rating. items = [{ big, label }]. Sources: family owned since 1994 (decisions-and-rules line 52),
    lifetime manufacturer warranty on the film (line 66), licensed and insured (line 102). -#}
{% macro proofRow(p) -%}
{%- if p and p.items and p.items.length %}
<section class="ws5-proofrow mood-dark bg-ink-1" aria-label="{{ p.label | safe }}">
  <div class="wrap">
    <ul class="ws5-proofrow__list list-plain">
{%- for it in p.items %}
      <li class="ws5-proofrow__i"><span class="ws5-proofrow__big">{{ it.big | safe }}</span> <span class="ws5-proofrow__lbl">{{ it.label | safe }}</span></li>
{%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
{%- endmacro %}

{#- o = { eyebrow, h1, lede, service, photo (ws5photos key), ramp (true = Light Ramp media),
          strip (true = ramp as a strip under the copy), build_link, build_href, proof, mood,
          ground, note, crumb_parent } -#}
{% macro pageHero(o) -%}
{%- set ph = ws5photos[o.photo] if o.photo else null -%}
{#- Peak pass R2 (CEO ruling "the big 35 stays", visual R1 item 11): a page may set v3.hero_numeral
    { big, unit, caption } to show one legal fact as a large numeral in the media column instead of the
    unlabeled ramp (/nevada-tint-law: the front side window floor, NRS 484D.440). -#}
{%- set pgv = pages[page_key].v3 if (page_key and pages[page_key] and pages[page_key].v3) else {} -%}
{%- set num = o.numeral or pgv.hero_numeral -%}
{%- set hasMedia = ph or num or o.ramp or (o.typelist and o.typelist.length) -%}
<section class="ws5-hero ws5-hero--page {{ o.ground or ('bg-paper-2' if o.mood == 'warm' else 'bg-ink-0') }}{% if not hasMedia %} ws5-hero--solo{% endif %}" aria-labelledby="hero-h">
  <div class="ws5-hero__in">
    <div class="ws5-hero__copy">
      {{ eyebrowLine(o.eyebrow, o.eyebrow_short) }}
      <h1 id="hero-h">{{ o.h1 | safe }}</h1>
      {% if o.lede %}<p class="t-lead fg-2 ws5-hero__sub measure">{{ o.lede | safe }}</p>{% endif %}
      {%- if o.price_line %}
      <p class="t-body ws5-hero__price measure">{{ o.price_line | safe }}{% if o.price_draft %} <span class="v3-prow__draft t-label">{{ pages.sections.draft_label | safe }}</span>{% endif %}</p>
      {%- endif %}
      {%- if o.service %}
      {#- Peak pass R2 (visual R1 item 15): the builder is a text link, so the call is the row's one button. -#}
      {%- if o.build_link %}<p class="ws5-buildlink ws5-buildlink--hero"><a href="{{ o.build_href or '/build-your-tint' }}" data-build-link>{{ o.build_link | safe }}</a></p>{% endif %}
      <div class="ws5-hero__act">
        {{ action({ slot: "hero", service: o.service }) }}
      </div>
      {%- endif %}
      {% if o.proof %}{{ proof(o.proof) }}{% endif %}
      {%- if o.strip %}
      <div class="ws5-hero__strip v3-ramp v3-ramp--strip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      {%- endif %}
    </div>
    {%- if hasMedia %}
    <div class="ws5-hero__media">
      {%- if ph %}
      <figure class="v3-hero-media v3-hero-media--photo" data-photo="{{ o.photo }}" data-photo-source="{{ ph.source }}">
        {{ picture(ph.item, "(min-width: 1024px) 50vw, 100vw", { alt: ph.alt, high: true }) }}
        {% if ph.caption %}<figcaption class="v3-hero-media__note">{{ ph.caption | safe }}</figcaption>{% endif %}
      </figure>
      {%- elif num %}
      <figure class="ws5-numeral">
        <p class="ws5-numeral__big" aria-hidden="true"><span class="tnum">{{ num.big | safe }}</span><span class="ws5-numeral__unit">{{ num.unit | safe }}</span></p>
        <figcaption class="t-body fg-2">{{ num.caption | safe }}</figcaption>
      </figure>
      {%- elif o.typelist and o.typelist.length %}
      {#- Peak pass R1 (visual 11): a page with no real photo (blinds) sets its subjects as a type list in
          the right column instead of leaving it empty. Decorative: the same names are in the page body. -#}
      <ul class="ws5-typelist list-plain" aria-hidden="true">{% for t in o.typelist %}<li>{{ t | safe }}</li>{% endfor %}</ul>
      {%- else %}
      {{ heroMedia({ mode: "ramp", note: o.note }) }}
      {%- endif %}
    </div>
    {%- endif %}
  </div>
</section>
{%- endmacro %}
