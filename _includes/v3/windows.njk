{% macro windows(key, cls) -%}
{%- set k = (key | string).split(".") | last -%}
{%- set c = cls if cls in ["car", "suv", "pickup", "van"] else "car" -%}
{%- set map = {
  "two_front_doors": ["fd"],
  "front-doors": ["fd"],
  "rear_doors_and_back_glass": ["rd", "back"],
  "rear-doors": ["rd"],
  "back-glass": ["back"],
  "full_vehicle": ["fd", "rd", "back"],
  "windshield-strip": ["strip"],
  "sunroof": ["sun"]
} -%}
{%- set on = map[k] -%}
{%- if on -%}
<svg class="v3-win v3-win--{{ c }}" viewBox="0 1 168 24" width="168" height="24" aria-hidden="true" focusable="false">
  <g class="v3-win__side">{{ _side(c, on) }}
  </g>
  <g class="v3-win__front" transform="translate(66 0)">{{ _front(c, on) }}
  </g>
  <g class="v3-win__back" transform="translate(120 0)">{{ _back(c, on) }}
  </g>
</svg>
{%- endif -%}
{%- endmacro %}

{% macro vehicle(cls) -%}
{%- set c = cls if cls in ["car", "suv", "pickup", "van"] else "car" -%}
<svg class="v3-veh v3-veh--{{ c }}" viewBox="0 1 60 24" width="60" height="24" aria-hidden="true" focusable="false">{{ _side(c, []) }}
</svg>
{%- endmacro %}
