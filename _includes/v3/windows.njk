{%- endif %}
{%- endmacro %}

{#- Back view, local 40 x 26 units. -#}
{% macro _back(c, on) -%}
{%- if c == "car" %}
    <path class="v3-win__body" d="M4 21.5v-6.1q0-2.4 3-3l3.6-4q1-1 2.8-1h13.2q1.8 0 2.8 1l3.6 4q3 .6 3 3v6.1z"/>
    <path class="v3-win__body" d="M5 21.5h5V24H5zM30 21.5h5V24h-5zM16 16.6h8v3.2h-8z"/>
    <path class="v3-win__mark" d="M5.6 14.6h6v2.4h-6zM28.4 14.6h6v2.4h-6z"/>
    <path class="v3-win__g{% if 'back' in on %} is-on{% endif %}" d="M11.6 12l2-3.1h12.8l2 3.1z"/>
{%- elif c == "pickup" %}
    <path class="v3-win__body" d="M10 12V7q0-2 2-2h16q2 0 2 2v5zM4 21.5V12h32v9.5z"/>
    <path class="v3-win__body" d="M5 21.5h5V24H5zM30 21.5h5V24h-5zM16 17.6h8v3h-8zM17.5 14h5v1.4h-5z"/>
    <path class="v3-win__mark" d="M4.6 13h2v5h-2zM33.4 13h2v5h-2z"/>
    <path class="v3-win__g{% if 'back' in on %} is-on{% endif %}" d="M12 10.6V7.2h16v3.4z"/>
{%- else %}
    <path class="v3-win__body" d="M4 21.5v-8.9q0-1.6 2-2l2.6-4.8q.8-1.2 2.4-1.2h18q1.6 0 2.4 1.2l2.6 4.8q2 .4 2 2v8.9z"/>
    <path class="v3-win__body" d="M5 21.5h5V24H5zM30 21.5h5V24h-5zM16 15.4h8v3.2h-8z"/>
    <path class="v3-win__mark" d="M5 11.6h2.4v5H5zM32.6 11.6H35v5h-2.4z"/>
    <path class="v3-win__g{% if 'back' in on %} is-on{% endif %}" d="M8.8 10.6l1.6-4.2h19.2l1.6 4.2z"/>
{%- endif %}
{%- endmacro %}

{% macro windows(key, cls) -%}
{%- set k = (key | string).split(".") | last -%}
{%- set c = cls if cls in ["car", "suv", "pickup", "van"] else "car" -%}
{%- set map = {
  "two_front_doors": ["fd"],
  "front-doors": ["fd"],
  "rear_doors_and_back_glass": ["rd", "back"],
  "rear-doors": ["rd"],
  "back-glass": ["back"],
  "full_vehicle": ["fd", "rd", "back"],
  "windshield-strip": ["strip"],
  "sunroof": ["sun"]
} -%}
{%- set on = map[k] -%}
{%- if on -%}
<svg class="v3-win v3-win--{{ c }}" viewBox="0 1 152 24" width="152" height="24" aria-hidden="true" focusable="false">
  <g class="v3-win__side">{{ _side(c, on) }}
  </g>
  <g class="v3-win__front" transform="translate(66 0)">{{ _front(c, on) }}
  </g>
  <g class="v3-win__back" transform="translate(112 0)">{{ _back(c, on) }}
  </g>
</svg>
{%- endif -%}
{%- endmacro %}

{% macro vehicle(cls) -%}
{%- set c = cls if cls in ["car", "suv", "pickup", "van"] else "car" -%}
<svg class="v3-veh v3-veh--{{ c }}" viewBox="0 1 60 24" width="60" height="24" aria-hidden="true" focusable="false">{{ _side(c, []) }}
</svg>
{%- endmacro %}
