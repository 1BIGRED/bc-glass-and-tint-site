    <path class="v3-win__body" d="M5 21.5h5V24H5zM30 21.5h5V24h-5zM1.6 8.6h3v2.2h-3zM35.4 8.6h3v2.2h-3z"/>
    <path class="v3-win__mark" d="M6 13.4h5.6v2.2H6zM28.4 13.4H34v2.2h-5.6z"/>
