    <path class="v3-win__g" d="M11.2 12l2-3.3h13.6l2 3.3z"/>
    <path class="v3-win__g{% if 'strip' in on %} is-on{% endif %}" d="M12.3 10.2l.9-1.5h13.6l.9 1.5z"/>
