<script>(function(){if(typeof gtag!=='function')return;document.addEventListener('click',function(e){var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;if(!a)return;var h=a.getAttribute('href')||'';if(h.indexOf('tel:')===0)gtag('event','call_click',{link_url:h});else if(h.indexOf('sms:')===0)gtag('event','text_click',{link_url:h});else if(h.indexOf('mailto:')===0)gtag('event','email_click',{link_url:h});},true);var f=document.querySelector('form[name="quote"]');if(f)f.addEventListener('submit',function(){var s=f.querySelector('[name="source"]');var sv=[];Array.prototype.forEach.call(f.querySelectorAll('input[name="service"]:checked'),function(c){sv.push(c.value)});if(!sv.length)return;gtag('event','generate_lead',{form_name:'quote',page_source:s?s.value:'',services:sv.join(', '),service_count:sv.length});},true);if(f){var st=false;f.addEventListener('focusin',function(){if(st)return;st=true;gtag('event','form_start',{form_name:'quote'});},true);}document.addEventListener('click',function(e){var a=e.target&&e.target.closest?e.target.closest('a[href]'):null;if(!a)return;var h=a.getAttribute('href')||'',t=(a.textContent||'').toLowerCase();if(h.indexOf('google.com/maps')>-1){if(t.indexOf('direction')>-1)gtag('event','directions_click',{link_url:h});else gtag('event','review_click',{platform:'google'});}else if(h.indexOf('yelp.com')>-1)gtag('event','review_click',{platform:'yelp'});else if(h.indexOf('tintwiz.me')>-1)gtag('event','review_click',{platform:'tintwiz'});},true);})();</script>