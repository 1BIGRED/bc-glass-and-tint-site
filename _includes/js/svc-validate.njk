<script>(function(){var f=document.querySelector('form[name="quote"]');if(!f)return;var fs=f.querySelector('.svcpick'),msg=f.querySelector('#svc-err'),boxes=f.querySelectorAll('input[name="service"]'),tried=false;if(!boxes.length)return;function anyOn(){for(var i=0;i<boxes.length;i++){if(boxes[i].checked)return true}return false}function paint(){var ok=anyOn();if(msg)msg.hidden=ok||!tried;if(fs){if(!ok&&tried){fs.classList.add('err');fs.setAttribute('aria-invalid','true')}else{fs.classList.remove('err');fs.removeAttribute('aria-invalid')}}}Array.prototype.forEach.call(boxes,function(c){c.addEventListener('change',paint)});document.addEventListener('submit',function(e){if(e.target!==f)return;if(anyOn())return;tried=true;paint();e.preventDefault();e.stopImmediatePropagation();fs.scrollIntoView({block:'center',behavior:'smooth'});boxes[0].focus();},true);})();</script>