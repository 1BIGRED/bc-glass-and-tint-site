<!-- Ads-launch lead-source capture. Reads utm_source, utm_medium, utm_campaign, gclid, ref
     from the URL, sanitizes and whitelists each one, keeps the first valid set for this
     browser session in sessionStorage, and fills the static hidden inputs above by name.
     Never creates a field; never touches the "source" field. Sends nothing anywhere by
     itself - only the visitor's own form submission does that, same as every other field.
     Source and 45/45 Node test results: 09 - Website\bc-glass-site-staging\README.md and the
     scratchpad's ads-launch\test-capture.js. -->
<script>(function(){'use strict';var STORAGE_KEY='bcgt_leadsrc';var REF_LABELS={postcard:'Postcard',mail:'Mail',truck:'Truck',sign:'Sign',card:'Card'};var UTM_PATTERN=/^[a-z0-9._-]{1,40}$/;var GCLID_PATTERN=/^[A-Za-z0-9_-]{10,200}$/;function sanitizeUtm(raw){if(typeof raw!=='string'){return '';}var v=raw.toLowerCase();return UTM_PATTERN.test(v)?v:'';}function sanitizeGclid(raw){if(typeof raw!=='string'){return '';}return GCLID_PATTERN.test(raw)?raw:'';}function sanitizeRef(raw){if(typeof raw!=='string'){return '';}var v=raw.toLowerCase();return Object.prototype.hasOwnProperty.call(REF_LABELS,v)?v:'';}function parseQuery(search){var out={};if(!search){return out;}var qs=search.charAt(0)==='?'?search.slice(1):search;if(!qs){return out;}var pairs=qs.split('&');for(var i=0;i<pairs.length;i++){var pair=pairs[i];if(!pair){continue;}var eq=pair.indexOf('=');var key,val;if(eq===-1){key=pair;val='';}else{key=pair.slice(0,eq);val=pair.slice(eq+1);}try{key=decodeURIComponent(key);}catch(e1){continue;}try{val=decodeURIComponent(val.replace(/\+/g,' '));}catch(e2){continue;}if(!Object.prototype.hasOwnProperty.call(out,key)){out[key]=val;}}return out;}function buildLeadSource(data){if(data.utm_source||data.utm_medium){if(data.utm_source&&data.utm_medium){return data.utm_source+' / '+data.utm_medium;}return data.utm_source||data.utm_medium;}if(data.ref&&Object.prototype.hasOwnProperty.call(REF_LABELS,data.ref)){return REF_LABELS[data.ref];}return '';}function readStored(){try{var raw=window.sessionStorage.getItem(STORAGE_KEY);if(!raw){return null;}var parsed=JSON.parse(raw);if(parsed&&typeof parsed==='object'){return parsed;}return null;}catch(e){return null;}}function writeStored(data){try{window.sessionStorage.setItem(STORAGE_KEY,JSON.stringify(data));}catch(e){}}function captureFromUrl(){var parsed=parseQuery(window.location.search);var utm_source=sanitizeUtm(parsed.utm_source);var utm_medium=sanitizeUtm(parsed.utm_medium);var utm_campaign=sanitizeUtm(parsed.utm_campaign);var gclid=sanitizeGclid(parsed.gclid);var ref=sanitizeRef(parsed.ref);if(!utm_source&&!utm_medium&&!utm_campaign&&!gclid&&!ref){return null;}var data={utm_source:utm_source,utm_medium:utm_medium,utm_campaign:utm_campaign,gclid:gclid,ref:ref};data.lead_source=buildLeadSource(data);return data;}var CURRENT=readStored();if(!CURRENT){var fresh=captureFromUrl();if(fresh){CURRENT=fresh;writeStored(fresh);}}function setField(form,name,value){if(!value){return;}var field=form.querySelector('[name="'+name+'"]');if(!field){return;}field.value=value;}function fillForms(){if(!CURRENT){return;}var forms=document.querySelectorAll('form[name="quote"]');for(var i=0;i<forms.length;i++){var form=forms[i];setField(form,'utm_source',CURRENT.utm_source);setField(form,'utm_medium',CURRENT.utm_medium);setField(form,'utm_campaign',CURRENT.utm_campaign);setField(form,'gclid',CURRENT.gclid);setField(form,'lead_source',CURRENT.lead_source);}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',fillForms,false);}else{fillForms();}})();</script>