<script>(function(){var f=document.querySelector('form[name="quote"]');if(!f)return;var t=document.getElementById("qthanks"),btn=f.querySelector('button[type="submit"]'),sent=false,done=false;/* Previously: a failed send left the visitor on the browser error page with every   field lost, a synchronous throw dead-ended the button with no message, and Back   after a successful send re-armed a duplicate lead. */var err=document.createElement("p");err.id="send-err";err.setAttribute("role","alert");err.hidden=true;err.style.cssText="margin:10px 0 0;padding:11px 13px;border-radius:8px;background:#4a1f1f;color:#ffdada;font-size:14px;line-height:1.55";err.innerHTML='That did not send. Check your signal and try again, or call us at <a href="tel:{{ site.phone.tel | safe }}" style="color:#ffdada;font-weight:700">{{ site.phone.display | safe }}</a>.';if(btn&&btn.parentNode){btn.parentNode.insertBefore(err,btn.nextSibling);btn.setAttribute("data-label",btn.textContent);}function busy(v){if(!btn)return;btn.disabled=!!v;btn.textContent=v?"Sending\u2026":btn.getAttribute("data-label");}function ok(){done=true;mark();busy(false);err.hidden=true;f.style.display="none";if(t){t.style.display="block";t.focus();t.scrollIntoView({behavior:"smooth",block:"center"});}}function fail(){sent=false;busy(false);err.hidden=false;err.scrollIntoView({block:"center"});}f.addEventListener("submit",function(e){if(done||sent){e.preventDefault();return;}var body;try{body=new URLSearchParams(new FormData(f)).toString();}catch(x){return;}if(typeof fetch!=="function")return;e.preventDefault();sent=true;err.hidden=true;busy(true);fetch("/",{method:"POST",headers:{"Content-Type":"application/x-www-form-urlencoded"},body:body}).then(function(r){if(!r.ok)throw 0;ok();}).catch(fail);});/* Restoring the sent state has to survive a full reload, not just bfcache, or   Back looks like the send failed and the visitor sends a duplicate. */var K="bcgt_sent_"+location.pathname;function mark(){try{sessionStorage.setItem(K,String(Date.now()))}catch(x){}}function recent(){try{var v=+sessionStorage.getItem(K);return v&&(Date.now()-v)<1800000}catch(x){return false}}window.addEventListener("pageshow",function(){if(!done&&recent()){done=true;f.style.display="none";if(t)t.style.display="block";}});})();</script>