<script>var burger=document.getElementById("burger"),mob=document.getElementById("mobnav");if(burger&&mob){var mset=function(on){mob.style.display=on?"block":"none";burger.setAttribute("aria-expanded",on?"true":"false");};burger.onclick=function(){var on=burger.getAttribute("aria-expanded")!=="true";mset(on);if(on){var fa=mob.querySelector("a");if(fa)fa.focus();}};mob.querySelectorAll("a").forEach(function(a){a.onclick=function(){mset(false);};});document.addEventListener("keydown",function(e){if((e.key==="Escape"||e.key==="Esc")&&burger.getAttribute("aria-expanded")==="true"){mset(false);burger.focus();}});/* the drawer is opened with an inline display:block, which outlives the mobile   media query - rotating to landscape left it open beside the desktop nav */window.addEventListener("resize",function(){if(window.innerWidth>760&&burger.getAttribute("aria-expanded")==="true"){mset(false);}});}</script>