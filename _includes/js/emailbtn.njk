<script>(function(){var eb=document.getElementById("emailbtn");if(!eb)return;var email="{{ site.email | safe }}";if(window.matchMedia("(hover: none) and (pointer: coarse)").matches)return;eb.addEventListener("click",function(e){e.preventDefault();function ok(){var t=eb.getAttribute("data-tip");eb.setAttribute("data-tip","Email copied!");eb.classList.add("tipshow");setTimeout(function(){eb.setAttribute("data-tip",t);eb.classList.remove("tipshow");},1600);}if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(email).then(ok,ok);}else{var ta=document.createElement("textarea");ta.value=email;document.body.appendChild(ta);ta.select();try{document.execCommand("copy");}catch(x){}ta.remove();ok();}});})();</script>