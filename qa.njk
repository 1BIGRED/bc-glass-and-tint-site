---
# Questions and answers, overhaul v3 (WS5; art direction 3.7): a reading column, H2 per topic,
# accordion rows. Every question and answer prints in the page (closed details) and the FAQPage
# JSON-LD (qa.11tydata.js) is built from the same items. The search box is progressive enhancement
# (rendered hidden; assets/v3/js/60-moments.js reveals it). One conversion path: no per-answer
# calls to action. Wording: _data/pages/qa.json v3.
layout: layouts/v3.njk
permalink: qa.html
slug: qa
page_key: qa
og_image: logo.png
bundles: ["service"]
---
{%- import "v3-service/blocks.njk" as b with context -%}
{%- set V = pages.qa.v3 -%}
{%- set total = qa_total -%}
<section class="ws5-hero ws5-hero--page ws5-hero--solo bg-ink-0" aria-labelledby="hero-h">
  <div class="ws5-hero__in">
    <div class="ws5-hero__copy">
      <p class="t-eyebrow">{{ V.eyebrow | safe }}</p>
      <h1 id="hero-h">{{ V.h1 | safe }}</h1>
      <p class="t-lead fg-2 measure">{{ V.lede | safe }}</p>
      <nav class="ws5-topics" aria-label="{{ V.topics_label | safe }}">{% for g in V.groups %}<a href="#{{ g.id }}">{{ g.heading | safe }}</a>{% endfor %}</nav>
      <div class="ws5-search" data-qa-search hidden>
        <label for="qa-q">{{ V.search.label | safe }}</label>
        <input id="qa-q" type="search" placeholder="{{ V.search.placeholder }}" autocomplete="off">
        <p class="t-label fg-2" aria-live="polite" data-qa-count data-tpl="{{ V.search.count_some }}" data-total="{{ total }}"></p>
        <p class="t-body" data-qa-empty hidden>{{ V.search.empty | safe }}</p>
      </div>
    </div>
  </div>
</section>

<section class="ws5-read bg-ink-0" aria-label="{{ V.h1 | safe }}">
  <div class="wrap">
    <div class="ws5-read__col">
{%- for g in V.groups %}
      <div class="ws5-qa-group" id="{{ g.id }}" data-qa-group>
        <h2>{{ g.heading | safe }}</h2>
        <div class="ws5-acc">
{%- for it in g.items %}
          <details class="ws5-acc__i" data-qa-item>
            <summary><span>{{ it.question | safe }}</span><i aria-hidden="true"></i></summary>
            <div class="ws5-acc__a">{{ it.answer | safe }}</div>
          </details>
{%- endfor %}
        </div>
      </div>
{%- endfor %}
    </div>
  </div>
</section>

{{ b.talk({ id: "quote", source: "Questions and answers", service: "any", uid: "talk", ground: "bg-ink-1" }) }}
