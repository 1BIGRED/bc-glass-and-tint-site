---
# FAQ page. All wording is in _data/pages/qa.json; markup lives here. FAQPage JSON-LD is
# the FIRST block (standalone), built from the same faq_main/faq_more items the page shows.
# Sticky call bar sits among the scripts, not right after the quote form. JSON-LD: qa.11tydata.js.
permalink: qa.html
slug: qa
page_key: qa
og_image: images/hero.jpg
---
{%- set pg = pages.qa -%}
{%- set sh = pages.shared -%}
{% include "head/top.njk" %}

{% include "head/meta.njk" %}
{% set ld = schema_ld[0] %}{% include "jsonld.njk" %}
{% set ld = schema_ld[1] %}{% include "jsonld.njk" %}
<style>
:root{--gold:#c9a23f;--dark:#191b1f;--ink:#1f2228;--mut:#565d64;--line:#e7e9ec;--soft:#f5f6f7}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--ink);line-height:1.6;background:#fff}
a{text-decoration:none;color:inherit}.skip-link{position:absolute;left:-9999px;top:0;background:var(--gold);color:#1f2228;font-weight:800;padding:10px 16px;border-radius:0 0 8px 0;z-index:200}.skip-link:focus{left:0}
.wrap{max-width:880px;margin:0 auto;padding:0 18px}
.ic{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;display:block}
.util{background:var(--dark);color:#cfd2d6;font-size:12.5px;padding:7px 16px;display:flex;gap:18px;justify-content:center;align-items:center;flex-wrap:wrap}
.util span,.util a{display:inline-flex;align-items:center;gap:6px}.util a{color:var(--gold);font-weight:600}.util .ic{width:14px;height:14px;color:var(--gold)}
header{position:sticky;top:0;z-index:60;background:#fff;border-bottom:3px solid var(--gold);box-shadow:0 1px 8px rgba(0,0,0,.06)}
.hrow{max-width:1100px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;gap:14px}
.brand{font-size:20px;font-weight:800}.brand b{color:#1f2228}.brand span{color:var(--goldd)}
nav a{font-size:14.5px;font-weight:600;color:#2b2e33;margin-left:20px}
.callbtn{background:var(--gold);color:#1f2228;font-weight:800;font-size:13.5px;padding:9px 15px;border-radius:7px;display:inline-flex;align-items:center;gap:6px;margin-left:20px}
.callbtn .ic{width:15px;height:15px;stroke-width:2.2}
.phero{background:var(--dark);color:#fff;text-align:center;padding:42px 18px}
.phero .crumb{font-size:12.5px;color:#9aa0a7;margin-bottom:10px}.phero .crumb a{color:var(--gold)}
.phero h1{font-size:30px;font-weight:800}
.phero p{color:#c9ccd1;font-size:15px;margin-top:8px}
section{padding:40px 0}
h2{font-size:21px;font-weight:800;margin-bottom:4px;color:var(--ink)}
h2 span{color:var(--goldd)}
.cat{border-top:1px solid var(--line);padding-top:26px;margin-top:26px}
.cat:first-of-type{border-top:0;margin-top:0;padding-top:0}
.qa{padding:15px 2px;border-bottom:1px solid var(--line)}
.qa .q{font-weight:700;font-size:16px;margin-bottom:5px}
.qa .a{font-size:14.5px;color:var(--mut)}
.cta{background:var(--soft);text-align:center;padding:36px 18px;border-radius:14px;margin-top:36px}
.cta h3{font-size:20px;font-weight:800;margin-bottom:6px}
.cta p{color:var(--mut);font-size:14px;margin-bottom:16px}
.cta a{background:var(--gold);color:#1f2228;font-weight:800;padding:13px 26px;border-radius:9px;display:inline-block;margin:6px 5px}
@media(max-width:520px){.cta a{display:block;margin:10px auto;max-width:260px}}
footer{background:var(--dark);color:#aeb2b8;font-size:13px;padding:30px 18px;text-align:center;line-height:1.8;margin-top:30px}
footer a{color:var(--gold);text-decoration:underline}
@media(max-width:620px){.phero h1{font-size:24px}}
.hrow nav.main{display:flex;align-items:center;gap:18px;flex-wrap:wrap;justify-content:flex-end}.hrow nav.main a{font-size:14.5px;font-weight:600;color:#2b2e33}.hrow nav.main a:hover{color:var(--goldsm)}
.storefronts{margin-top:24px;background:var(--soft);border-radius:14px;padding:22px}
.storefronts h3{font-size:17px;font-weight:800;margin-bottom:4px}
.storefronts p{font-size:13.5px;color:var(--mut);margin-bottom:14px}
.sfgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.sfcell{aspect-ratio:4/3;border:2px dashed #cfd3d8;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#9aa0a7;font-size:13px;font-weight:600;background:#fff;text-align:center;padding:8px}
.burger{display:none;background:none;border:0;color:#1f2228;cursor:pointer;padding:8px;margin:-8px}.burger .ic{width:28px;height:28px}
.mobnav{display:none;background:#fff;border-bottom:1px solid var(--line)}
.mobnav a{display:block;padding:13px 20px;font-weight:600;border-top:1px solid var(--line)}
@media(max-width:760px){.hrow nav.main{display:none}.burger{display:block}}
@media(max-width:620px){.sfgrid{grid-template-columns:1fr 1fr}}
[data-tip]{position:relative}
[data-tip]::after{content:attr(data-tip);position:absolute;left:50%;top:calc(100% + 11px);transform:translateX(-50%) translateY(-5px);width:max-content;max-width:230px;text-align:center;background:#1f2228;color:#fff;font-size:13px;font-weight:600;line-height:1.4;padding:10px 14px;border-radius:10px;border:2px solid var(--gold);box-shadow:0 10px 26px rgba(0,0,0,.26);opacity:0;pointer-events:none;transition:opacity .16s ease,transform .16s ease;z-index:300}
[data-tip]::before{content:"";position:absolute;left:50%;top:calc(100% + 3px);transform:translateX(-50%) translateY(-5px);border:8px solid transparent;border-bottom-color:var(--gold);opacity:0;pointer-events:none;transition:opacity .16s ease,transform .16s ease;z-index:300}
[data-tip]:hover::after,[data-tip]:focus-visible::after,[data-tip].tipshow::after,[data-tip]:hover::before,[data-tip]:focus-visible::before,[data-tip].tipshow::before{opacity:1;transform:translateX(-50%) translateY(0)}
@media(max-width:760px){[data-tip]::after,[data-tip]::before{display:none}}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #8C6B14;outline-offset:2px}
.skip-link{position:absolute;left:-9999px;top:0;z-index:9999;background:var(--gold);color:#191b1f;padding:10px 16px;font-weight:800;text-decoration:none;border-radius:0 0 8px 0}.skip-link:focus{left:0}
/* Quote form styling. This page carries the same quote form as the other 16 pages but was
   missing every one of these rules, so the fields, the submit button and the post-submit
   thank you panel all rendered as unstyled browser defaults. Copied from the live homepage
   stylesheet so the form matches the rest of the site exactly. */
.sub{font-size:14.5px;color:var(--mut);text-align:center;max-width:600px;margin:0 auto 32px}
.quote{background:var(--dark);color:#fff}
.quote h2{color:#fff}
.quote .sub{color:#aeb2b8}
form{max-width:500px;margin:0 auto;display:grid;gap:11px}
form input,form select,form textarea{width:100%;padding:13px;border-radius:9px;border:0;font-size:16px;font-family:inherit}
form textarea{min-height:84px;resize:vertical}
form .send{background:var(--gold);color:#1f2228;font-weight:800;font-size:16px;padding:15px;border:0;border-radius:9px;cursor:pointer}
.hp{position:absolute;left:-9999px}
.qthanks{text-align:center;padding:6px 0}
.qthanks-in{background:#fff;max-width:520px;margin:0 auto;border-radius:14px;padding:34px 26px;box-shadow:0 12px 34px rgba(0,0,0,.22)}
.qthanks .qcheck{width:58px;height:58px;margin:0 auto 14px;display:block;color:var(--gold);stroke:var(--gold);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.qthanks h3{font-size:22px;font-weight:800;color:var(--ink);margin-bottom:8px}
.qthanks p{font-size:14.5px;color:var(--mut);margin-bottom:18px;line-height:1.6}
.qthanks .tbtn{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:#1f2228;font-weight:800;font-size:15px;padding:12px 24px;border-radius:9px}
.qthanks .tbtn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
/* Also missing on this page only. .soft is the alternating section background used by the
   Headlights and Taillights section, and footer .fcols is the three column footer grid that
   every other page has. Without them that section lost its grey band and the footer columns
   stacked instead of sitting in a row. */
.soft{background:var(--soft)}
footer .fcols{display:grid;grid-template-columns:1fr;gap:18px;max-width:820px;margin:0 auto 22px;text-align:left}
@media(min-width:761px){footer .fcols{grid-template-columns:repeat(4,1fr)}}
























{% include "a11y-block.njk" %}
{% include "css/tail.njk" %}
{% include "head/clarity.njk" %}
</head>
<body>
{% include "skip-link.njk" %}
{% include "sprite.njk" %}
{% include "util.njk" %}
{% include "header.njk" %}
<main id="main" tabindex="-1">

<div class="phero">
  <h1>{{ pg.hero.heading | safe }}</h1>
  <p>{{ pg.hero.intro_lead | safe }}<a href="tel:{{ site.phone.tel | safe }}">{{ site.phone.display | safe }}</a>{{ pg.hero.intro_tail | safe }}</p>
<div class="pbtns"><a class="qbtn" href="tel:{{ site.phone.tel | safe }}">{{ sh.buttons.call | safe }} {{ site.phone.display | safe }}</a><a class="qbtn" style="background:transparent;color:#fff;border:1.5px solid #6f7885" href="#quote">{{ sh.buttons.free_quote | safe }}</a></div></div>

<section><div class="wrap">

{% for g in pg.faq_main %}  <div class="cat"{% if g.id %} id="{{ g.id | safe }}"{% endif %}>
    <h2>{{ g.heading | safe }}</h2>
    {% for item in g.items %}{% if not loop.first and not item.compact %}
    {% endif %}<div class="qa"><h3 class="q">{{ item.question | safe }}</h3><div class="a">{{ item.answer | safe }}</div></div>{% endfor %}{% if g.last %}</div></div></section><section class="soft"><div class="wrap"><h2>{{ pg.faq_more.heading | safe }}</h2>{% for item in pg.faq_more.items %}{% if not loop.first and not item.compact %}
    {% endif %}<div class="qa"><h3 class="q">{{ item.question | safe }}</h3><div class="a">{{ item.answer | safe }}</div></div>{% endfor %}


  <div class="cta">
    <h3>{{ pg.cta.heading | safe }}</h3>
    <p>{{ pg.cta.text | safe }}</p>
    <a href="tel:{{ site.phone.tel | safe }}">{{ sh.buttons.call | safe }} {{ site.phone.display | safe }}</a><a href="#quote">{{ sh.buttons.free_quote | safe }}</a>
  </div>

</div></section>{% else %}
{% if g.trailing_blank %}
{% endif %}  </div>

{% endif %}{% endfor %}

{% include "quote.njk" %}
</main>
{% include "footer.njk" %}
{% include "js/burger.njk" %}
{% include "js/emailbtn.njk" %}
{% include "js/anim.njk" %}
{% include "js/quote-submit.njk" %}
{% include "js/source-vin.njk" %}
{% include "sticky-call.njk" %}
{% include "js/gtag-events.njk" %}
{% include "cookie-bar.njk" %}
{% include "js/cookie.njk" %}
{% include "js/svc-validate.njk" %}
</body>
</html>
