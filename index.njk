---
# Homepage, v2 (website overhaul, 2026-10-29). Layout: _includes/layouts/v2.njk. Styles:
# assets/v2/v2.css. Wording: _data/pages/home.json (pg.v2 for the new sections; pg.faq for the
# FAQ; pg.quote for the quote form). Phone, hours, address: _data/site.json. Prices: only
# _data/pricing.json, through the gate in index.11tydata.js (v2_prices): a number shows only
# when that entry is status "confirmed" AND publish true AND not legal_hold; anything else
# prints the quiet "Call for a quote". Reviews: picked by name from
# the verbatim quotes in _data/pages/reviews.json (index.11tydata.js v2_reviews). Gallery strip:
# _data/gallery.json (v2_gallery). JSON-LD: index.11tydata.js; its FAQPage is built from the
# same pg.faq.items printed below, every item, so the visible FAQ and the schema match.
layout: layouts/v2.njk
permalink: index.html
slug: index
page_key: home
og_image: images/hero.jpg
hero_preload: hero-taycan
---
{%- from "v2/macros.njk" import pic, galleryPic -%}
{%- set pg = pages.home -%}
{%- set v = pg.v2 -%}
{%- set tel = site.phone.tel -%}
{%- set callText = pages.shared.v2.call + " " + site.phone.display_call -%}

<section class="v2-hero" id="top">
  {{ pic(v2images[v.hero.image], v.hero.image_alt, "100vw", "v2-hero__img", { eager: true, high: true }) | safe }}
  <div class="v2-hero__shade" aria-hidden="true"></div>
  <div class="v2-wrap v2-hero__in">
    <div class="v2-hero__copy">
      <p class="v2-eyebrow">{{ v.hero.eyebrow | safe }}</p>
      <h1 class="v2-hero__h1">{{ v.hero.heading | safe }}</h1>
      <p class="v2-hero__lede">{{ v.hero.lede | safe }}</p>
{%- set hp = v2_prices[v.hero.price] %}
{%- if hp %}
      <p class="v2-hero__price">{{ v.hero.price_label | safe }} <span class="v2-num">{{ hp.display | safe }}</span></p>
{%- endif %}
      <div class="v2-hero__actions">
        <a class="v2-btn v2-btn--gold v2-btn--xl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
        <a class="v2-textlink" href="{{ v.hero.build_href | safe }}">{{ v.hero.build_link | safe }}</a>
      </div>
      <p class="v2-hero__note">{{ v.hero.call_note | safe }} {{ site.hours.display | safe }}.</p>
    </div>
  </div>
</section>

{%- set q1 = v2_reviews[0] %}
{%- if q1 %}
<section class="v2-phonequote" aria-label="{{ v.phone_quote.label | safe }}">
  <p class="v2-phonequote__q">"{{ q1.quote | safe }}"</p>
  <p class="v2-phonequote__by">{{ q1.name | safe }}, {{ v.phone_quote.label | safe }} · {{ v.phone_quote.rating_line | fill | safe }}</p>
</section>
{%- endif %}

<section class="v2-proof" aria-label="Why BC Glass and Tint">
  <div class="v2-wrap v2-proof__grid">
{%- for p in v.proof %}
    <div class="v2-proof__item"><span class="v2-proof__t">{{ p.title | fill | safe }}</span><span class="v2-proof__s">{{ p.text | fill | safe }}</span></div>
{%- endfor %}
  </div>
</section>

<section class="v2-section" id="build" aria-labelledby="build-h">
  <div class="v2-wrap v2-split">
    <div class="v2-panel v2-build__visual">
      <svg viewBox="0 0 600 230" role="img" aria-label="{{ v.build.svg_label | safe }}" width="600" height="230">
        <path class="ill-body" d="M30 168 L30 132 Q32 116 62 112 L176 104 L236 64 Q246 58 262 58 L392 58 Q408 58 420 66 L478 104 L546 112 Q570 116 570 136 L570 168 Z"/>
        <polygon class="ill-glass" points="196,104 246,68 318,68 318,104"/>
        <polygon class="ill-tint" points="196,104 246,68 318,68 318,104" fill-opacity="0.38"/>
        <polygon class="ill-glass" points="326,68 396,68 412,74 448,104 326,104"/>
        <polygon class="ill-tint" points="326,68 396,68 412,74 448,104 326,104" fill-opacity="0.58"/>
        <polygon class="ill-glass" points="452,100 420,72 428,70 470,104"/>
        <polygon class="ill-tint" points="452,100 420,72 428,70 470,104" fill-opacity="0.58"/>
        <circle class="ill-wheel" cx="140" cy="168" r="30"/><circle class="ill-hub" cx="140" cy="168" r="12"/>
        <circle class="ill-wheel" cx="470" cy="168" r="30"/><circle class="ill-hub" cx="470" cy="168" r="12"/>
      </svg>
      <ul class="v2-chips" aria-label="Windows in this build">
{%- for c in v.build.chips %}
        <li class="v2-chip{% if loop.first %} is-on{% endif %}">{{ c | safe }}</li>
{%- endfor %}
      </ul>
      <p class="v2-small">{{ v.build.note | safe }}</p>
    </div>
    <div class="v2-stack">
      <p class="v2-eyebrow">{{ v.build.eyebrow | safe }}</p>
      <h2 class="v2-h2" id="build-h">{{ v.build.heading | safe }}</h2>
      <p class="v2-body">{{ v.build.text | safe }}</p>
      <div class="v2-estimate">
        <span class="v2-small">{{ v.build.estimate_label | safe }}</span>
{%- set ep = v2_prices[v.build.estimate_price] %}
{%- if ep %}
        <span class="v2-price v2-num">{{ ep.display | safe }}</span>
{%- else %}
        <span class="v2-price v2-price--unknown">{{ v.prices.unknown | safe }}</span>
{%- endif %}
        <span class="v2-small">{{ v.build.estimate_note | safe }}</span>
      </div>
      <div><a class="v2-btn v2-btn--outline" href="{{ v.build.href | safe }}">{{ v.build.cta | safe }}</a></div>
    </div>
  </div>
</section>

<section class="v2-band v2-section" id="prices" aria-labelledby="prices-h">
  <div class="v2-wrap v2-stack v2-stack--lg">
    <div class="v2-stack v2-intro">
      <p class="v2-eyebrow">{{ v.prices.eyebrow | safe }}</p>
      <h2 class="v2-h2" id="prices-h">{{ v.prices.heading | safe }}</h2>
      <p class="v2-body">{{ v.prices.text | safe }}</p>
    </div>
    <div class="v2-prices">
{%- for c in v.prices.cards %}
{%- set p = v2_prices[c.price] %}
{%- set np = v2_prices[c.note_price] %}
      <div class="v2-pcard{% if c.featured %} v2-pcard--featured{% endif %}{% if c.phone_only %} v2-only-phone{% endif %}">
        <span class="v2-pcard__t">{{ c.title | safe }}</span>
        <span class="v2-pcard__s">{{ c.sub | safe }}</span>
{%- if p %}
        <span class="v2-price v2-num">{{ p.display | safe }}</span>{% if np and c.note %}<span class="v2-pcard__n">{{ c.note | replace("{price}", np.display) | safe }}</span>{% elif c.note_alone %}<span class="v2-pcard__n">{{ c.note_alone | safe }}</span>{% endif %}
{%- else %}
        <span class="v2-price v2-price--unknown">{{ v.prices.unknown | safe }}</span>
{%- endif %}
        <a class="v2-pcard__cta" href="tel:{{ tel | safe }}">{{ c.cta | safe }}</a>
      </div>
{%- endfor %}
    </div>
    <p class="v2-small">{{ v.prices.footnote | safe }}<a href="{{ v.prices.href | safe }}">{{ v.prices.footnote_link | safe }}</a>.</p>
  </div>
</section>

{%- if v2_gallery.length %}
<section class="v2-section" id="gallery" aria-labelledby="gallery-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <div class="v2-headrow">
      <div class="v2-stack v2-intro">
        <p class="v2-eyebrow">{{ v.gallery.eyebrow | safe }}</p>
        <h2 class="v2-h2" id="gallery-h">{{ v.gallery.heading | safe }}</h2>
      </div>
      <a class="v2-link" href="{{ v.gallery.href | safe }}">{{ v.gallery.link | safe }}</a>
    </div>
    <div class="v2-gallery" role="region" aria-label="{{ v.gallery.eyebrow | safe }}" tabindex="0">
{%- for it in v2_gallery %}
      <figure class="v2-gallery__item">{{ galleryPic(it, "(min-width: 1024px) 290px, (min-width: 768px) 23vw, 240px", "v2-gallery__img") | safe }}<figcaption>{{ it.title | safe }}</figcaption></figure>
{%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="v2-band v2-section" id="services" aria-labelledby="services-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <h2 class="v2-h2" id="services-h">{{ v.services.heading | safe }}</h2>
    <div class="v2-tiles">
{%- for t in v.services.tiles %}
      <a class="v2-tile" href="{{ t.href | safe }}">
{%- if t.image and v2images[t.image] %}{{ pic(v2images[t.image], "", "(min-width: 1024px) 390px, 33vw", "v2-tile__img") | safe }}
{%- elif t.gallery_id and v2_gallery_by_id[t.gallery_id] %}{{ galleryPic(v2_gallery_by_id[t.gallery_id], "(min-width: 1024px) 390px, 33vw", "v2-tile__img", "") | safe }}{% endif %}
        <span class="v2-tile__t"><span class="v2-only-wide">{{ t.title | safe }}</span><span class="v2-only-phone">{{ (t.short or t.title) | safe }}</span></span>
        <span class="v2-tile__s">{{ t.text | safe }}</span>
      </a>
{%- endfor %}
    </div>
    <ul class="v2-svcchips">
{%- for c in v.services.chips %}
      <li><a href="{{ c.href | safe }}"{% if c.external %} rel="noopener"{% endif %}>{{ c.label | safe }}</a></li>
{%- endfor %}
    </ul>
  </div>
</section>

{%- if v2_reviews.length %}
<section class="v2-section v2-hide-phone" aria-labelledby="reviews-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <h2 class="v2-h2" id="reviews-h">{{ v.reviews.heading | safe }}</h2>
    <div class="v2-quotes">
{%- for r in v2_reviews %}
      <blockquote class="v2-quote"><p>"{{ r.quote | safe }}"</p><footer>{{ r.name | safe }}, {{ v.reviews.label | safe }}</footer></blockquote>
{%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

<section class="v2-band v2-how v2-hide-phone" aria-labelledby="how-h">
  <div class="v2-wrap">
    <h2 class="v2-sr" id="how-h">{{ v.how.heading | safe }}</h2>
    <ol class="v2-how__grid">
{%- for s in v.how.steps %}
      <li><span class="v2-how__t">{{ s.title | safe }}</span><span class="v2-how__s">{{ s.text | safe }}</span></li>
{%- endfor %}
    </ol>
  </div>
</section>

<section class="v2-section" id="faq" aria-labelledby="faq-h">
  <div class="v2-wrap v2-faq">
    <h2 class="v2-h2" id="faq-h">{{ v.faq.heading | safe }}</h2>
    <div class="v2-faq__list">
{%- for f in pg.faq.items %}
      <details class="v2-faq__item">
        <summary><h3 class="v2-faq__q">{{ f.question | safe }}</h3><span class="v2-faq__plus" aria-hidden="true"></span></summary>
        <div class="v2-faq__a"><p>{{ f.answer | safe }}</p></div>
      </details>
{%- endfor %}
    </div>
    <p class="v2-small"><a href="/qa">{{ pg.faq.more_link | safe }}</a></p>
  </div>
</section>

{%- set week = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] %}
{%- set closedDays = [] %}
{%- for d in week %}{% if not (d in site.hours.days) %}{% set _n = closedDays.push(d) %}{% endif %}{% endfor %}
<section class="v2-band v2-section v2-contactwrap" aria-labelledby="contact-h">
  <div class="v2-wrap v2-contact">
    <div class="v2-contact__talk">
      <h2 class="v2-h2 v2-h2--xl" id="contact-h">{{ v.contact.heading | safe }}</h2>
      <a class="v2-btn v2-btn--gold v2-btn--xxl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
      <span class="v2-status v2-status--lg" data-bc-status><span class="v2-dot" aria-hidden="true"></span><span class="v2-status__txt"></span></span>
      <p class="v2-body">{{ site.address.display | safe }}<br>{{ site.hours.display | safe }}.{% if closedDays.length %} {{ v.contact.closed_prefix | safe }} {{ closedDays | join(" and ") }}.{% endif %}</p>
      <a class="v2-link v2-only-phone" href="#quote">{{ v.contact.callback_link | safe }}</a>
    </div>
    <div class="v2-contact__form">
{% include "quote.njk" %}
    </div>
  </div>
</section>
