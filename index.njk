---
# Homepage, overhaul v3 (WS5). The routed spine of blueprint section 3:
#   hero (H1 + router "My car / My home or office / My windshield" + status + one action + proof),
#   Your car., Your home or office., Your windshield., In their words., How booking works.,
#   Also done at the shop. (id="services", the /services redirect target), Before you book.,
#   Talk to a person. (id="quote", the request form anchor).
# Layout: layouts/v3.njk. Look: overhaul-v3/03-ART-DIRECTION-visual.md 2 and 3.1. Section macros:
# _includes/v3-service/blocks.njk. Wording: _data/pages/home.json v3 and pages/sections.json.
# Booking controls: the WS2 action macro only. Prices: the WS4 priceRow macro only (gate in
# lib/pricing.js). Reviews: featurable Google reviews only (_data/reviews.json).
# Hero mode: home.json v3.hero.media_mode, "ramp" (default) or "storefront" (index.11tydata.js).
layout: layouts/v3.njk
permalink: index.html
slug: index
page_key: home
og_image: logo.png
bundles: ["home"]
---
{%- import "v3-service/blocks.njk" as b with context -%}
{%- from "v3/hero.njk" import homeHero with context -%}
{%- set H = pages.home.v3 -%}
{%- set heroData = { eyebrow: H.hero.eyebrow, h1: H.hero.h1, sub: H.hero.sub, router_label: H.hero.router_label, proof: H.hero.proof, media: hero } -%}
{{ homeHero(heroData, ws5_router) }}

{{ b.carLane({ uid: "car" }) }}

{{ b.homeLane({ uid: "home" }) }}

{{ b.chipLane({ uid: "ws" }) }}

{{ b.words() }}

{{ b.howBooking("any", { uid: "how" }) }}

{{ b.alsoDone({ id: "services" }) }}

{{ b.faq(H.faq.items, { uid: "faq", ground: "bg-ink-1" }) }}

{{ b.talk({ id: "quote", source: "Homepage", uid: "talk" }) }}
