<script>
  var RM=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var burger=document.getElementById("burger"),mob=document.getElementById("mobnav");if(burger&&mob){var mset=function(on){mob.style.display=on?"block":"none";burger.setAttribute("aria-expanded",on?"true":"false");};burger.onclick=function(){var on=burger.getAttribute("aria-expanded")!=="true";mset(on);if(on){var fa=mob.querySelector("a");if(fa)fa.focus();}};mob.querySelectorAll("a").forEach(function(a){a.onclick=function(){mset(false);};});document.addEventListener("keydown",function(e){if((e.key==="Escape"||e.key==="Esc")&&burger.getAttribute("aria-expanded")==="true"){mset(false);burger.focus();}});/* the drawer is opened with an inline display:block, which outlives the mobile   media query - rotating to landscape left it open beside the desktop nav */window.addEventListener("resize",function(){if(window.innerWidth>760&&burger.getAttribute("aria-expanded")==="true"){mset(false);}});}
  document.querySelectorAll('[data-carousel]').forEach(function(c,idx){
    var sl=[].slice.call(c.querySelectorAll('.slide'));if(sl.length<2)return;
    var dots=document.createElement('div');dots.className='dots';
    sl.forEach(function(_,k){var d=document.createElement('button');d.type='button';d.className='dot'+(k===0?' on':'');d.setAttribute('aria-label','Show photo '+(k+1)+' of '+sl.length);if(k===0)d.setAttribute('aria-current','true');d.addEventListener('click',function(){go(k);});d.addEventListener('mouseenter',function(){var im=sl[k]&&sl[k].querySelector('img[data-src]');if(im){im.src=im.getAttribute('data-src');im.removeAttribute('data-src');}});dots.appendChild(d);});
    c.appendChild(dots);var i=0;
    function hydrate(n){var im=sl[n]&&sl[n].querySelector('img[data-src]');if(im){im.src=im.getAttribute('data-src');im.removeAttribute('data-src');}}
    function go(n){sl[i].classList.remove('on');dots.children[i].classList.remove('on');dots.children[i].removeAttribute('aria-current');i=n;hydrate(i);sl[i].classList.add('on');dots.children[i].classList.add('on');dots.children[i].setAttribute('aria-current','true');}
    
  });
  document.querySelectorAll('[data-rslider]').forEach(function(s){
    var track=s.querySelector('.rtrack');var _k=[].slice.call(track.children);for(var _a=_k.length-1;_a>0;_a--){var _b=Math.floor(Math.random()*(_a+1)),_t=_k[_a];_k[_a]=_k[_b];_k[_b]=_t;}_k.forEach(function(k){track.appendChild(k);});var cards=[].slice.call(track.children),dw=s.querySelector('.rdots');
    var page=0,per=3,pages=1,t;
    function calc(){var w=window.innerWidth;return w<761?1:(w<1001?2:3);}
    function render(){
      per=calc();pages=Math.max(1,Math.ceil(cards.length/per));
      if(page>pages-1)page=pages-1;
      cards.forEach(function(c){c.style.flex='0 0 '+(100/per)+'%';c.style.maxWidth=(100/per)+'%';});
      track.style.transform='translateX(-'+(page*100)+'%)';
      var __focus=document.activeElement,__i=__focus&&__focus.parentNode===dw?[].indexOf.call(dw.children,__focus):-1;dw.innerHTML='';
      if(pages>1){
        var prev=document.createElement('button');prev.type='button';prev.className='rnav';prev.setAttribute('aria-label','Previous reviews');prev.textContent='‹';prev.onclick=function(){page=(page-1+pages)%pages;render();start();};dw.appendChild(prev);
        var md=5,sd=0;if(pages>md){sd=Math.min(Math.max(page-2,0),pages-md);}
        for(var p=sd;p<Math.min(sd+md,pages);p++){(function(p){var b=document.createElement('button');b.type='button';b.className='rdot'+(p===page?' on':'');b.setAttribute('aria-label','Reviews page '+(p+1));b.onclick=function(){page=p;render();start();};dw.appendChild(b);})(p);}
        var nx=document.createElement('button');nx.type='button';nx.className='rnav';nx.setAttribute('aria-label','Next reviews');nx.textContent='›';nx.onclick=function(){page=(page+1)%pages;render();start();};dw.appendChild(nx);
        /* render() rebuilds these controls, which destroyed the focused button and
           dropped focus to <body> - a keyboard user could only ever press once. */
        if(__i>-1&&dw.children[__i]&&dw.children[__i].focus)dw.children[__i].focus();
      }
    }
    var paused=false,userPaused=false;function start(){clearInterval(t);if(RM||paused||userPaused)return;t=setInterval(function(){page=(page+1)%pages;render();},15000);}function hold(){paused=true;clearInterval(t);}function release(){paused=false;start();}(function(){var d=s.querySelector(".rdots");if(!d)return;var pb=document.createElement("button");pb.type="button";pb.className="rnav rpause";pb.setAttribute("aria-pressed","false");pb.setAttribute("aria-label","Pause the review slideshow");pb.innerHTML="&#10073;&#10073;";pb.addEventListener("click",function(){userPaused=!userPaused;pb.setAttribute("aria-pressed",userPaused?"true":"false");pb.setAttribute("aria-label",userPaused?"Play the review slideshow":"Pause the review slideshow");pb.innerHTML=userPaused?"&#9654;":"&#10073;&#10073;";if(userPaused){clearInterval(t);}else{start();}});function keep(){if(!d.querySelector(".rpause"))d.appendChild(pb);}keep();var _r=render;render=function(){_r.apply(this,arguments);keep();};})();s.addEventListener('mouseenter',hold);s.addEventListener('mouseleave',release);s.addEventListener('focusin',hold);s.addEventListener('focusout',release);
    window.addEventListener('resize',render);
    render();start();
  });
  document.querySelectorAll('img.lazyimg').forEach(function(im){function d(){im.classList.add('loaded');var k=im.closest('.skel');if(k)k.classList.add('loaded');}if(im.complete&&im.naturalWidth)d();else{im.addEventListener('load',d);im.addEventListener('error',d);}});
</script>
