---
# Prices, v3 (WS4; blueprint 4.3 and 6.1, art direction 3.4). Layout: layouts/v3.njk. Wording:
# _data/pages/prices.json. Every price: _data/pricing.json through lib/pricing.js in
# prices.11tydata.js (pr_car, pr_home, pr_ws). A price that does not pass the gate prints the
# blueprint 6.1 words for its context; a preview draft carries the "Draft price" tag. Full windshield
# film is on legal hold and has no row anywhere. Below 560px the car table is one class at a time
# (CSS radio switch, works without JavaScript); every table is real <table> markup.
layout: layouts/v3.njk
permalink: prices.html
slug: prices
page_key: prices
bundles: ["prices"]
---
{%- from "v3/actions.njk" import action with context -%}
{%- import "v3-service/blocks.njk" as b with context -%}
{%- from "v3/price.njk" import priceRow, priceValue with context -%}
{%- set pg = pages.prices -%}
{%- set sc = pg.sections.car -%}
{%- set sh = pg.sections.home -%}
{%- set sw = pg.sections.windshield -%}
{%- macro cell(q, fallback) -%}
{%- if q.show %}<span class="v3-price">{% if q.from %}<span class="v3-price__from t-label fg-2">From</span> {% endif %}<span class="t-price tnum">{{ q.value | safe }}</span>{% if q.draft %} <span class="v3-price__draft t-label">{{ pg.draft_tag | safe }}</span>{% endif %}</span>{% else %}<span class="v3-price__fallback fg-2">{{ fallback | safe }}</span>{% endif -%}
{%- endmacro -%}

<section class="pr-top" aria-labelledby="pr-h">
  <div class="wrap stack-16">
    <nav class="pr-crumb t-label fg-2" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{{ pg.hero.crumb | safe }}</span></nav>
    <p class="t-eyebrow">{{ pg.hero.eyebrow | safe }}</p>
    <h1 id="pr-h">{{ pg.hero.heading | safe }}</h1>
    <p class="t-lead measure">{% if pr_any %}{{ pg.hero.intro | safe }}{% else %}{{ pg.hero.intro_without_prices | safe }}{% endif %}</p>
  </div>
</section>

<section class="pr-sec" id="{{ sc.id }}" aria-labelledby="pr-car-h" data-section="prices-car">
  <div class="wrap pr-sec__in">
    <div class="pr-sec__head stack-16">
      <h2 id="pr-car-h">{{ sc.heading | safe }}</h2>
      <p class="t-body fg-2 measure">{{ sc.lede | safe }}</p>
    </div>
    <div class="pr-sec__body stack-24">
{%- if pr_car.any_shown %}
      <table class="pr-table pr-table--grid" data-price-block>
        <caption class="vh">{{ sc.heading | safe }}</caption>
        <thead><tr><th scope="col">{{ sc.column_label | safe }}</th>{% for c in pr_car.classes %}<th scope="col">{{ c.label | safe }}</th>{% endfor %}</tr></thead>
        <tbody>
{%- for r in pr_car.rows %}
          <tr><th scope="row">{{ r.label | safe }}</th>{% for q in r.cells %}<td>{{ cell(q, sc.fallback) }}</td>{% endfor %}</tr>
{%- endfor %}
        </tbody>
      </table>
      <div class="pr-phone" role="radiogroup" aria-label="{{ sc.switch_label | safe }}">
{%- for c in pr_car.classes %}
        <input class="vh pr-phone__in" type="radio" name="pr-class" id="pr-c-{{ c.id }}" value="{{ c.id }}"{% if loop.first %} checked{% endif %}>
{%- endfor %}
        <div class="pr-seg" aria-hidden="true">
{%- for c in pr_car.classes %}
          <label class="pr-seg__opt" for="pr-c-{{ c.id }}">{{ c.label | safe }}</label>
{%- endfor %}
        </div>
        <div class="pr-ctables">
{%- for c in pr_car.classes %}
{%- set ci = loop.index0 %}
          <table class="pr-table pr-ct" data-c="{{ c.id }}">
            <caption class="vh">{{ sc.heading | safe }}, {{ c.label | safe }}</caption>
            <thead><tr><th scope="col">{{ sc.column_label | safe }}</th><th scope="col">{{ c.label | safe }}</th></tr></thead>
            <tbody>
{%- for r in pr_car.rows %}
              <tr><th scope="row">{{ r.label | safe }}</th><td>{{ cell(r.cells[ci], sc.fallback) }}</td></tr>
{%- endfor %}
            </tbody>
          </table>
{%- endfor %}
        </div>
      </div>
{%- if pr_car.fvp.length %}
      <div class="pr-arith t-body">
        <p>{{ sc.arithmetic_intro | safe }}</p>
{%- for x in pr_car.fvp %}
        <p class="tnum">{{ sc.arithmetic_class | replace("{class}", x.label) | replace("{front}", x.f.front.money) | replace("{rear}", x.f.rear.money) | replace("{full}", x.f.full.money) | safe }}{% if x.f.draft %} <span class="v3-price__draft t-label">{{ pg.draft_tag | safe }}</span>{% endif %}</p>
{%- endfor %}
      </div>
{%- endif %}
{%- else %}
      <dl class="v3-prices">
{%- for r in pr_car.rows %}
        <div class="v3-prow" data-price-block><dt class="v3-prow__label t-body">{{ r.label | safe }}</dt><dd class="v3-prow__value"><span class="v3-price__fallback fg-2">{{ sc.fallback | safe }}</span></dd></div>
{%- endfor %}
      </dl>
      <p class="t-body fg-2 measure">{{ sc.no_prices_note | safe }}</p>
{%- endif %}
      <p class="t-label fg-2 measure">{{ sc.footnote | safe }}</p>
      <div class="pr-moves">
        <h3 class="t-label pr-moves__h">{{ sc.moves_heading | safe }}</h3>
        <ul class="list-plain pr-moves__list t-body">
{%- for m in sc.moves %}
          <li>{{ m | safe }}</li>
{%- endfor %}
        </ul>
      </div>
      <div class="pr-acts">
        <a class="pr-btn" href="/build-your-tint">{% if pr_has_auto %}{{ sc.builder_link | safe }}{% else %}{{ sc.builder_link_without_prices | safe }}{% endif %}</a>
        {{ action({ slot: "price", service: "car" }) }}
      </div>
{%- if pr_reviewed %}
      <p class="t-label fg-2">{{ pr_reviewed }}</p>
{%- endif %}
{%- if sc.review %}
      {#- Peak pass R1 (psychology 9): one verbatim featurable Google review about price beside the car rows. -#}
      {{ b.quote(reviews | ws5review(sc.review), { cls: "ws5-quote--price" }) }}
{%- endif %}
    </div>
  </div>
</section>

<section class="pr-sec pr-sec--home mood-warm" id="{{ sh.id }}" aria-labelledby="pr-home-h" data-section="prices-home">
  <div class="wrap pr-sec__in">
    <div class="pr-sec__head stack-16">
      <h2 id="pr-home-h">{{ sh.heading | safe }}</h2>
      <p class="t-body fg-2 measure">{{ sh.lede | safe }}</p>
    </div>
    <div class="pr-sec__body stack-24">
      <dl class="v3-prices">
{%- for r in pr_home %}
        <div class="v3-prow" data-price-block><dt class="v3-prow__label t-body">{{ r.label | safe }}</dt><dd class="v3-prow__value">{{ cell(r.cell, r.fallback) }}</dd></div>
{%- endfor %}
      </dl>
      <div class="pr-moves">
        <h3 class="t-label pr-moves__h">{{ sh.moves_heading | safe }}</h3>
        <ul class="list-plain pr-moves__list t-body">
{%- for m in sh.moves %}
          <li>{{ m | safe }}</li>
{%- endfor %}
        </ul>
      </div>
      <div class="pr-acts">{{ action({ slot: "price", service: "home" }) }}</div>
{%- if pr_reviewed %}
      <p class="t-label fg-2">{{ pr_reviewed }}</p>
{%- endif %}
    </div>
  </div>
</section>

<section class="pr-sec" id="{{ sw.id }}" aria-labelledby="pr-ws-h" data-section="prices-windshield">
  <div class="wrap pr-sec__in">
    <div class="pr-sec__head stack-16">
      <h2 id="pr-ws-h">{{ sw.heading | safe }}</h2>
      <p class="t-body fg-2 measure">{{ sw.lede | safe }}</p>
    </div>
    <div class="pr-sec__body stack-24">
      <dl class="v3-prices">
{%- for r in pr_ws %}
        <div class="v3-prow" data-price-block><dt class="v3-prow__label t-body">{{ r.label | safe }}</dt><dd class="v3-prow__value">{{ cell(r.cell, r.fallback) }}</dd></div>
{%- endfor %}
{%- for r in sw.text_rows %}
        <div class="v3-prow"><dt class="v3-prow__label t-body">{{ r.label | safe }}</dt><dd class="v3-prow__value"><span class="v3-price__fallback fg-2">{{ r.text | safe }}</span></dd></div>
{%- endfor %}
      </dl>
      <div class="pr-moves">
        <h3 class="t-label pr-moves__h">{{ sw.moves_heading | safe }}</h3>
        <ul class="list-plain pr-moves__list t-body">
{%- for m in sw.moves %}
          <li>{{ m | safe }}</li>
{%- endfor %}
        </ul>
      </div>
      <div class="pr-acts">{{ action({ slot: "price", service: "chip" }) }}</div>
{%- if pr_reviewed %}
      <p class="t-label fg-2">{{ pr_reviewed }}</p>
{%- endif %}
    </div>
  </div>
</section>

<section class="pr-sec pr-sec--faq bg-band" aria-labelledby="pr-faq-h">
  <div class="wrap pr-sec__in">
    <div class="pr-sec__head">
      <h2 id="pr-faq-h">{{ pg.faq.heading | safe }}</h2>
    </div>
    <div class="pr-sec__body">
      <div class="pr-faq">
{%- for it in pr_faq %}
        <details class="pr-faq__item">
          <summary><span class="pr-faq__q">{{ it.question | safe }}</span><span class="pr-faq__plus" aria-hidden="true"></span></summary>
          <p class="pr-faq__a t-body measure">{{ it.answer | safe }}</p>
        </details>
{%- endfor %}
      </div>
      <p class="t-label fg-2 pr-legal">{{ pg.legal_footer | safe }}</p>
    </div>
  </div>
</section>
