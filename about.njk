---
# About, now "The shop" (overhaul v3, WS5; blueprint 2; art direction 3.7): Showroom Black, hero =
# the storefront wide crop, a second section with the bay frame, "Family owned since 1994." set as
# the headline fact. Faceless throughout. The Google map embed stays (the approved privacy policy
# says it loads with this page). Wording: _data/pages/about.json v3. JSON-LD: about.11tydata.js.
layout: layouts/v3.njk
permalink: about.html
slug: about
page_key: about
bundles: ["home", "service"]
---
{%- import "v3-service/blocks.njk" as b with context -%}
{%- from "v3/hero.njk" import pageHero with context -%}
{%- set V = pages.about.v3 -%}
{{ pageHero({ eyebrow: V.eyebrow, h1: V.h1, lede: V.lede, service: "any", photo: V.hero_photo, ground: "bg-ink-0" }) }}

<section class="section bg-ink-1" aria-labelledby="fact-h">
  <div class="wrap">
    <h2 id="fact-h" class="ws5-fact-h">{{ V.fact | safe }}</h2>
    <div class="ws5-prose measure stack-16 ws5-mt-32">{% for p in V.story %}<p>{{ p | safe }}</p>{% endfor %}</div>
  </div>
</section>

<section class="ws5-lane section bg-ink-0" aria-labelledby="bay-h">
  <div class="wrap grid ws5-lane__grid ws5-lane__grid--mirror">
    {%- if ws5photos[V.bay_photo] %}
    <div class="ws5-lane__media">{{ b.photo(V.bay_photo, "(min-width: 1024px) 50vw, 100vw", { ratio: "43" }) }}</div>
    {%- endif %}
    <div class="ws5-lane__copy">
      <h2 id="bay-h">{{ V.bay_h2 | safe }}</h2>
      <p class="t-lead fg-2 measure ws5-mt-24">{{ V.bay_text | safe }}</p>
    </div>
  </div>
</section>

<section class="section--minor bg-ink-1" aria-labelledby="find-h">
  <div class="wrap">
    <h2 id="find-h">{{ V.find_h2 | safe }}</h2>
    <p class="t-body ws5-mt-24">{{ site.address.display | safe }}<br>{{ pages.sections.talk.hours | safe }}<br><a href="{{ site.maps_url | safe }}" target="_blank" rel="noopener">{{ V.directions | safe }}</a></p>
    <div class="ws5-map">
      <iframe title="{{ V.map_title | safe }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3229.125768716298!2d-114.85933912364771!3d35.968350514147495!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80c92b72b46cc5db%3A0xbdb7c36540900252!2sBC%20Glass%20%26%20Tint!5e0!3m2!1sen!2sus!4v1787777120579!5m2!1sen!2sus"></iframe>
    </div>
  </div>
</section>

{{ b.howBooking("any", { uid: "how" }) }}

{{ b.talk({ id: "quote", source: "About", service: "any", uid: "talk", photo: "none" }) }}
