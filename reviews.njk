---
# Reviews page, v2 (website overhaul, 2026-10-29). Layout: _includes/layouts/v2.njk. Styles:
# assets/v2/v2.css plus assets/v2/pages.css. Wording: _data/pages/reviews.json. Only Google
# review text is reproduced (verbatim, from google_block.items, which the homepage also reads by
# name); Yelp review text is never reproduced here (Yelp's terms), only a plain link to the
# profile. Counts and ratings print only through the site.json tokens (the fill filter).
# JSON-LD: reviews.11tydata.js (business, WebSite, WebPage; no aggregateRating).
layout: layouts/v2.njk
extra_css: ["/assets/v2/pages.css"]
permalink: reviews.html
slug: reviews
page_key: reviews
og_image: images/hero.jpg
---
{%- set pg = pages.reviews -%}
{%- set v = pg.v2 -%}
{%- set sh = pages.shared -%}
{%- set tel = site.phone.tel -%}
{%- set callText = sh.v2.call + " " + site.phone.display_call -%}

<section class="pg-head" aria-labelledby="pg-h1">
  <div class="v2-wrap pg-head__in">
    <div class="pg-head__copy">
      <p class="v2-eyebrow">{{ v.eyebrow | safe }}</p>
      <h1 class="pg-h1" id="pg-h1">What Our Customers Say</h1>
      <p class="pg-lede">{{ pg.hero.sub | fill | safe }}</p>
      <div class="pg-actions">
        <a class="v2-btn v2-btn--gold v2-btn--xl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
        <a class="v2-textlink" href="{{ site.maps_url | safe }}" target="_blank" rel="noopener">{{ v.leave_link | safe }}</a>
      </div>
    </div>
    <div class="pg-meter pg-meter--rating">
      <p class="pg-meter__num v2-num">{{ pg.ratings.google.score | fill | safe }}</p>
      <p class="pg-meter__label">{{ pg.ratings.google.label | safe }}</p>
      <p class="pg-meter__text">{{ pg.ratings.google.count | fill | safe }}</p>
      <a class="v2-link" href="{{ site.maps_url | safe }}" target="_blank" rel="noopener">{{ pg.ratings.google.cta | safe }}</a>
    </div>
  </div>
</section>

<section class="v2-section" aria-labelledby="quotes-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="quotes-h">{{ v.list_heading | safe }}</h2>
    </div>
    <div class="pg-quotes">
{%- for r in pg.google_block.items %}
      <blockquote class="pg-quote"><p>"{{ r.quote | safe }}"</p><footer>{{ r.name | safe }}, {{ v.list_label | safe }}</footer></blockquote>
{%- endfor %}
    </div>
    <p><a class="v2-link" href="{{ site.maps_url | safe }}" target="_blank" rel="noopener">{{ pg.google_block.all_link | fill | safe }}</a></p>
  </div>
</section>

<section class="v2-band v2-section" aria-labelledby="source-h">
  <div class="v2-wrap v2-stack v2-stack--md">
    <div class="v2-stack v2-intro">
      <h2 class="v2-h2" id="source-h">{{ v.other_heading | safe }}</h2>
      <p class="v2-body">{{ pg.ratings.note | safe }}</p>
    </div>
    <ul class="v2-svcchips">
      <li><a href="{{ site.maps_url | safe }}" target="_blank" rel="noopener">{{ pg.ratings.google.cta | safe }}</a></li>
      <li><a href="{{ site.social.yelp | safe }}" target="_blank" rel="noopener">{{ pg.yelp_block.link_text | safe }}</a></li>
      <li><a href="{{ site.social.tintwiz | safe }}" target="_blank" rel="noopener">{{ pg.yelp_block.tintwiz_link_text | safe }}</a></li>
    </ul>
  </div>
</section>

{%- set week = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] %}
{%- set closedDays = [] %}
{%- for d in week %}{% if not (d in site.hours.days) %}{% set _n = closedDays.push(d) %}{% endif %}{% endfor %}
<section class="v2-band v2-section v2-contactwrap" aria-labelledby="contact-h">
  <div class="v2-wrap v2-contact">
    <div class="v2-contact__talk">
      <h2 class="v2-h2 v2-h2--xl" id="contact-h">{{ v.contact.heading | safe }}</h2>
      <a class="v2-btn v2-btn--gold v2-btn--xxl" href="tel:{{ tel | safe }}">{{ callText | safe }}</a>
      <span class="v2-status v2-status--lg" data-bc-status><span class="v2-dot" aria-hidden="true"></span><span class="v2-status__txt"></span></span>
      <p class="v2-body">{{ site.address.display | safe }}<br>{{ site.hours.display | safe }}.{% if closedDays.length %} {{ v.contact.closed_prefix | safe }} {{ closedDays | join(" and ") }}.{% endif %}</p>
    </div>
    <div class="v2-contact__form">
{% include "quote.njk" %}
    </div>
  </div>
</section>
