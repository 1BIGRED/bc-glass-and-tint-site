---
# Reviews, overhaul v3 (WS5). Art direction 3.7: the V-a review block repeated in one column, the
# platform line at the top (only from a fresh live read), no filters, no stars, no platform logos.
# Only featurable Google reviews from _data/reviews.json print (lib/eleventy-ws5.js ws5featured).
# Wording: _data/pages/reviews.json v3. JSON-LD: reviews.11tydata.js (no rating markup, ever).
layout: layouts/v3.njk
permalink: reviews.html
slug: reviews
page_key: reviews
og_image: logo.png
bundles: ["service"]
---
{%- import "v3-service/blocks.njk" as b with context -%}
{%- set V = pages.reviews.v3 -%}
{%- set rv = site.reviews or {} -%}
<section class="ws5-hero ws5-hero--page ws5-hero--solo bg-ink-0" aria-labelledby="hero-h">
  <div class="ws5-hero__in">
    <div class="ws5-hero__copy">
      <p class="t-eyebrow">{{ V.eyebrow | safe }}</p>
      <h1 id="hero-h">{{ V.h1 | safe }}</h1>
      <p class="t-lead fg-2 measure">{{ V.lede | safe }}</p>
      <p class="t-label fg-2">{% if rv.google_as_of and (rv.google_as_of | ws5fresh(14)) %}Google: {{ rv.google_rating }} from {{ rv.google_count }} reviews, read {{ (rv.google_as_of_label or rv.google_as_of) | safe }}. {% endif %}<a href="{{ reviews.listing_url | safe }}" target="_blank" rel="noopener">{{ V.google_link | safe }}</a></p>
    </div>
  </div>
</section>

<section class="ws5-read bg-ink-0" aria-label="Selected reviews">
  <div class="wrap">
    <div class="ws5-read__col ws5-revlist">
{%- for r in reviews | ws5featured(null, 50) %}
      {{ b.quote(r) }}
{%- endfor %}
    </div>
  </div>
</section>

<section class="section--minor bg-ink-1" aria-labelledby="other-h">
  <div class="wrap">
    {{ b.head(null, V.other_h2, "other-h") }}
    <ul class="ws5-list list-plain">
      <li class="ws5-list__i"><a href="{{ reviews.listing_url | safe }}" target="_blank" rel="noopener">{{ V.leave | safe }}</a></li>
{%- for o in V.other %}
      <li class="ws5-list__i"><a href="{{ site.social[o.key] | safe }}" target="_blank" rel="noopener">{{ o.label | safe }}</a></li>
{%- endfor %}
    </ul>
  </div>
</section>

{{ b.talk({ id: "quote", source: "Reviews", service: "any", uid: "talk" }) }}
