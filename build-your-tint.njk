---
# Build Your Tint, v3 (WS4; blueprint 4.5, art direction 3.6 "the stage", engineering 3.2.3 and 3.2.5).
# Layout: layouts/v3.njk. Wording: _data/pages/build_your_tint.json. Data: build-your-tint.11tydata.js
# (bt_config, gated for this build's price mode). Behavior: assets/v3/js/builder/50-builder.js.
# Styles: assets/v3/css/builder/50-builder.css. No number is typed here: prices reach the page only
# through lib/pricing.js. Front-door shades darker than the legal line are not in the markup at all.
# Without JavaScript the tool is hidden and the rules table in <noscript> shows instead.
layout: layouts/v3.njk
permalink: build-your-tint.html
slug: build-your-tint
page_key: build_your_tint
og_image: images/hero.jpg
bundles: ["builder"]
---
{%- from "v3/actions.njk" import action with context -%}
{%- set pg = pages.build_your_tint -%}
{%- set C = bt_config -%}
{%- set steps = pg.steps.with_presets if C.presets.length else pg.steps.without_presets -%}
<noscript><style>.bt-app,.bt-bar{display:none !important}</style></noscript>

<section class="bt-top" aria-labelledby="bt-h">
  <div class="wrap stack-16">
    <nav class="bt-crumb t-label fg-2" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{{ pg.hero.crumb | safe }}</span></nav>
    <p class="t-eyebrow">{{ pg.hero.eyebrow | safe }}</p>
    <h1 id="bt-h">{% if bt_has_price %}{{ pg.hero.heading | safe }}{% else %}{{ pg.hero.heading_without_prices | safe }}{% endif %}</h1>
    <p class="t-lead measure">{{ pg.hero.intro | safe }}</p>
  </div>
</section>

<section class="bt" id="build" data-bt data-kind="empty" data-price-mode="{{ C.mode }}" aria-label="{{ pg.hero.crumb | safe }}">

  <div class="bt-bar" data-bt-bar role="region" aria-label="{{ pg.bar.label | safe }}">
    <div class="wrap bt-bar__in">
      <p class="bt-bar__total"><span class="vh">{{ pg.bar.total_label | safe }}: </span><span class="bt-bar__v t-price tnum" data-bt-total>{{ C.text.empty | safe }}</span>{% if C.mode == "preview" %}<span class="bt-draft t-label" data-bt-draft hidden>{{ pg.result.draft_tag | safe }}</span>{% endif %}</p>
      <p class="bt-bar__code t-label"><span class="fg-2">{{ pg.bar.code_label | safe }}</span> <code class="tnum" data-bt-code>{{ pg.result.code_empty | safe }}</code></p>
    </div>
  </div>

  <div class="wrap bt-app">
    <ol class="bt-steps t-label" aria-label="{{ pg.steps.label | safe }}" data-bt-steps>
{%- for s in steps %}
      <li data-step="{{ loop.index }}"{% if loop.first %} aria-current="step"{% endif %}><span class="tnum">{{ loop.index }}</span> {{ s | safe }}</li>
{%- endfor %}
    </ol>

    <div class="bt-resume" data-bt-resume hidden>
      <p class="t-body">{{ pg.result.resume_text | safe }}</p>
      <button type="button" class="bt-btn" data-bt-resume-go>{{ pg.result.resume_label | safe }}</button>
      <button type="button" class="bt-link" data-bt-resume-clear>{{ pg.result.start_over_label | safe }}</button>
    </div>

    <div class="bt-grid">
      <figure class="bt-stage" data-bt-stage>
        <div class="bt-stage__view">
          <svg class="bt-svg" data-bt-svg viewBox="40 44 730 262" width="730" height="262" aria-hidden="true" focusable="false">
            <defs>
{%- for bd in bt_bodies %}
              <path id="btb-{{ bd.id }}" d="{{ bd.body }}"/>
{%- endfor %}
            </defs>
            <ellipse class="bt-floor" cx="405" cy="294" rx="330" ry="9"/>
{%- for bd in bt_bodies %}
            <g class="bt-body" data-body="{{ bd.id }}"{% if not loop.first %} hidden{% endif %}>
{%- for w in ["front", "rear", "back"] %}
              <g class="bt-win" data-win="{{ w }}">
                <path class="bt-win__glass" d="{{ bd.glass[w] }}"/>
                <path class="bt-win__tint" d="{{ bd.glass[w] }}" data-tint="{{ w }}"/>
                <path class="bt-win__edge" d="{{ bd.glass[w] }}"/>
              </g>
{%- endfor %}
              <use href="#btb-{{ bd.id }}" class="bt-line"/>
{%- for s in bd.seams %}
              <path class="bt-line bt-line--seam" d="{{ s }}"/>
{%- endfor %}
{%- for wh in bd.wheels %}
              <circle class="bt-line" cx="{{ wh[0] }}" cy="{{ wh[1] }}" r="{{ bd.r }}"/>
              <circle class="bt-line bt-line--seam" cx="{{ wh[0] }}" cy="{{ wh[1] }}" r="{{ bd.r * 0.6 }}"/>
{%- endfor %}
            </g>
{%- endfor %}
          </svg>
        </div>
        <figcaption class="bt-cap t-label fg-2">{{ pg.stage.caption | safe }}</figcaption>
      </figure>

      <div class="bt-side stack-48">
        <fieldset class="bt-step" data-bt-vehicles>
          <legend class="t-h3">{{ pg.vehicle.heading | safe }}</legend>
          <div class="bt-vgrid">
{%- for c in C.classes %}
{%- set bd = bt_body_ids[c.id] %}
            <label class="bt-tile bt-veh"><input class="vh" type="radio" name="bt-v" value="{{ c.id }}"><span class="bt-tile__box">{% if bd %}<svg class="bt-veh__svg" viewBox="56 56 704 240" aria-hidden="true" focusable="false"><use href="#btb-{{ c.id }}"/>{% for wh in bd.wheels %}<circle cx="{{ wh[0] }}" cy="{{ wh[1] }}" r="{{ bd.r }}"/>{% endfor %}</svg>{% endif %}<span class="bt-tile__t">{{ c.label | safe }}</span></span></label>
{%- endfor %}
          </div>
          <div class="bt-model">
            <label class="bt-model__l t-label" for="bt-model">{{ pg.vehicle.model_label | safe }}</label>
            <input class="bt-input" id="bt-model" name="bt-model" type="text" maxlength="60" autocomplete="off" aria-describedby="bt-model-hint" data-bt-model>
            <p class="t-label fg-2" id="bt-model-hint">{{ pg.vehicle.model_hint | safe }}</p>
          </div>
        </fieldset>

{%- if C.presets.length %}
        <fieldset class="bt-step" data-bt-presets>
          <legend class="t-h3">{{ pg.presets.heading | safe }}</legend>
          <div class="bt-plist">
{%- for p in C.presets %}
            <label class="bt-tile bt-preset"><input class="vh" type="radio" name="bt-preset" value="{{ p.id }}"><span class="bt-tile__box"><span class="bt-tile__t">{{ p.label | safe }}</span>{% if p.description %}<span class="bt-tile__d t-label fg-2">{{ p.description | safe }}</span>{% endif %}{% if p.draft %}<span class="bt-draft t-label">{{ pg.result.draft_tag | safe }}</span>{% endif %}</span></label>
{%- endfor %}
          </div>
{%- if bt_examples.length %}
          <div class="bt-examples">
            <p class="t-label fg-2">{{ pg.presets.examples_heading | safe }}</p>
            <ul class="list-plain bt-examples__list">
{%- for ex in bt_examples %}
              <li><button type="button" class="bt-link" data-bt-example data-vehicle="{{ ex.vehicle }}" data-preset="{{ ex.preset }}">{{ ex.label | safe }}</button>{% if ex.price.show %} <span class="t-label fg-2 tnum">{{ ex.price.display | safe }}</span>{% if ex.price.draft %} <span class="bt-draft t-label">{{ pg.result.draft_tag | safe }}</span>{% endif %}{% endif %}</li>
{%- endfor %}
            </ul>
          </div>
{%- endif %}
        </fieldset>
{%- endif %}
      </div>

      <div class="bt-tune" data-bt-tune>
        <h2 class="t-h3">{% if C.presets.length %}{{ pg.windows.heading_with_presets | safe }}{% else %}{{ pg.windows.heading_without_presets | safe }}{% endif %}</h2>
        <p class="t-body fg-2">{{ pg.windows.intro | safe }}</p>
{%- for w in C.windows %}
        <fieldset class="bt-wrow" data-bt-window="{{ w.id }}">
          <legend class="bt-wrow__h"><span class="bt-wrow__name">{{ w.label | safe }}</span> <span class="bt-wrow__val t-label fg-2" data-bt-wval>{{ pg.windows.no_film | safe }}</span></legend>
          <div class="bt-scale">
            <label class="bt-pane bt-pane--none"><input class="vh" type="radio" name="bt-w-{{ w.id }}" value="0" checked><span class="bt-pane__glass" aria-hidden="true"></span><span class="bt-pane__t t-label">{{ pg.windows.no_film | safe }}</span></label>
{%- for s in C.shades[w.id] %}
            <label class="bt-pane"><input class="vh" type="radio" name="bt-w-{{ w.id }}" value="{{ s.v }}"><span class="bt-pane__glass" style="--a:{{ s.a }}" aria-hidden="true"></span>{% if s.num %}<span class="bt-pane__t t-label tnum">{{ s.name }}</span>{% else %}<span class="vh">{{ s.name | safe }}</span>{% endif %}</label>
{%- endfor %}
          </div>
          <p class="bt-scale__ends t-label fg-2" aria-hidden="true"><span>{{ pg.windows.lighter | safe }}</span><span>{{ pg.windows.darker | safe }}</span></p>
          <p class="bt-wrow__legal t-label fg-2">{{ w.legal | safe }}</p>
        </fieldset>
{%- endfor %}
{%- if not C.shades.rear[0].num %}
        <p class="t-label fg-2">{{ pricing.example_shades.label | safe }}. {{ pg.stage.note | safe }}</p>
{%- else %}
        <p class="t-label fg-2">{{ pg.stage.note | safe }}</p>
{%- endif %}
      </div>

      <div class="bt-result" data-bt-result aria-labelledby="bt-result-h">
        <h2 class="t-h2" id="bt-result-h">{{ pg.result.heading | safe }}</h2>
        <dl class="bt-total">
          <div class="bt-total__row">
            <dt class="t-body">{{ pg.result.total_label | safe }}</dt>
            <dd><span class="t-price tnum" data-bt-total>{{ C.text.empty | safe }}</span>{% if C.mode == "preview" %}<span class="bt-draft t-label" data-bt-draft hidden>{{ pg.result.draft_tag | safe }}</span>{% endif %}</dd>
          </div>
        </dl>
        <p class="t-label fg-2" data-bt-pricenote hidden>{{ pg.result.price_note | safe }}</p>
        <p class="t-label fg-2" data-bt-fallbacknote hidden>{{ pg.result.fallback_note | safe }}</p>
        <p class="t-body bt-summary" data-bt-summary hidden></p>
        <p class="t-label"><span class="fg-2">{{ pg.result.code_label | safe }}</span> <code class="tnum bt-code" data-bt-code>{{ pg.result.code_empty | safe }}</code></p>
        <p class="t-label fg-2">{{ pg.result.code_hint | safe }}</p>
        <div data-bt-parts-wrap hidden>
          <p class="t-label fg-2">{{ pg.result.parts_label | safe }}</p>
          <dl class="bt-parts" data-bt-parts></dl>
        </div>
        <p class="t-body bt-fvp" data-bt-fvp hidden></p>

        <fieldset class="bt-extras" data-bt-addons hidden>
          <legend class="t-label bt-extras__h">{{ pg.result.addons_heading | safe }}</legend>
          <div data-bt-addon-list></div>
        </fieldset>
        <fieldset class="bt-extras" data-bt-ask>
          <legend class="t-label bt-extras__h">{{ pg.result.ask_heading | safe }}</legend>
          <div data-bt-ask-dyn></div>
{%- for a in C.also_ask %}
          <label class="bt-check"><input type="checkbox" name="bt-ask" value="{{ a.id }}"><span class="bt-check__box" aria-hidden="true"></span><span class="bt-check__t"><span>{{ a.label | safe }}</span> <span class="fg-2">({{ pg.result.ask_price | safe }}){% if a.benefit %}: {{ a.benefit | safe }}{% endif %}</span></span></label>
{%- endfor %}
          <p class="t-label fg-2">{{ pg.result.ask_note | safe }}</p>
        </fieldset>
        <ul class="list-plain bt-legal t-label fg-2" data-bt-legal></ul>

        <div class="bt-acts" data-bt-actions>
          {#- The WS2 action macro renders every booking control here by the hours (Call with this
              build / Text this build / Request a time); builder.js hands it the code through the
              bc:build event, and it links Request a time to /book?s=car&b=<code>. -#}
          <div class="bt-acts__primary" data-bt-primary>{{ action({ slot: "builder", service: "car", build: true }) }}</div>
        </div>
        <p class="t-label fg-2">{{ pg.result.request_note | safe }} {{ pg.result.warranty | safe }}</p>
        <p class="vh" data-bt-live aria-live="polite" role="status"></p>
      </div>
    </div>

    <p class="bt-foot t-label fg-2">{{ pg.legal_footer | safe }}</p>
  </div>

  <noscript>
    <div class="wrap bt-nojs stack-24">
      <h2 class="t-h3">{{ pg.noscript.heading | safe }}</h2>
      <p class="t-body">{{ pg.noscript.intro | safe }}</p>
      <table class="bt-table">
        <thead><tr><th scope="col">{{ pg.noscript.columns[0] | safe }}</th><th scope="col">{{ pg.noscript.columns[1] | safe }}</th></tr></thead>
        <tbody>
{%- for r in bt_noscript %}
          <tr><th scope="row">{{ r.label | safe }}</th><td>{{ r.legal | safe }}</td></tr>
{%- endfor %}
        </tbody>
      </table>
      <p class="t-body"><a href="/prices">{{ pg.noscript.prices_link | safe }}</a></p>
      <div class="bt-acts">{{ action({ slot: "builder", service: "car" }) }}</div>
      <p class="t-label fg-2">{{ pg.legal_footer | safe }}</p>
    </div>
  </noscript>

  <script type="application/json" data-bt-config>{{ C | jsonld | replace("<", "\\u003c") | safe }}</script>
</section>
